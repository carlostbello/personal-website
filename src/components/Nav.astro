---
import { site } from '../lib/site';
const path = Astro.url.pathname;
---
<header class="nav wrap">
  <a class="home lettering" href="/" aria-label={`${site.name}, home`}>CB</a>
  <nav aria-label="Main">
    {site.nav.map(({ label, href }) => (
      <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
  }
  .home {
    font-size: 2rem;
    text-decoration: none;
    transition: transform 0.25s var(--pop);
  }
  .home:hover {
    transform: rotate(-6deg) scale(1.08);
  }
  nav {
    display: flex;
    gap: clamp(14px, 3vw, 30px);
  }
  nav a {
    font-weight: 700;
    text-decoration: none;
    position: relative;
  }
  /* Active page gets a hand-drawn orange underline. */
  nav a::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: -4px;
    height: 5px;
    background: var(--accent);
    border-radius: 3px 1px 4px 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--snap);
  }
  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
</style>
