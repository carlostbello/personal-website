---
// Image with a hand-lettered caption: <Figure src={img} alt="…" caption="…" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---
<figure>
  <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 860px" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 2em 0;
  }
  figure :global(img) {
    width: 100%;
    height: auto;
    border: var(--line) solid var(--ink);
  }
  figcaption {
    display: inline-block;
    margin-top: -2px;
    background: var(--accent);
    border: var(--line) solid var(--ink);
    padding: 2px 10px;
    font-family: var(--f-hand);
    font-size: 1.1rem;
  }
</style>
