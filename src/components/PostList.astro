---
import { dateFmt, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  showYear?: boolean;
}
const { posts, showYear = false } = Astro.props;
const fmt = showYear ? dateFmt.short : dateFmt.monthDay;
---
<ol class="panel list">
  {posts.map((post) => (
    <li>
      <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
      <div>
        <a href={`/log/${post.id}`}>{post.data.title}</a>
        {post.data.draft && <span class="flag">draft</span>}
        <p>{post.data.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .list {
    list-style: none;
    margin: 0;
  }
  li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding-block: 12px;
  }
  li + li {
    border-top: 2px dashed var(--ink);
  }
  time {
    font-family: var(--f-hand);
    font-size: 1.15rem;
  }
  a {
    font-weight: 700;
    font-size: 1.15rem;
  }
  p {
    margin: 2px 0 0;
    color: var(--ink-soft);
  }
  .flag {
    margin-left: 8px;
    background: var(--accent);
    font-family: var(--f-hand);
    padding: 0 6px;
    border: 2px solid var(--ink);
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
