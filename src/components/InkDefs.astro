---
// Displacement filters for the line-boil effect (see .boil in global.css).
const seeds = { a: 2, b: 7, c: 13 };
---
<svg width="0" height="0" aria-hidden="true" style="position:absolute">
  {Object.entries(seeds).map(([id, seed]) => (
    <filter id={`boil-${id}`} x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed={seed} />
      <feDisplacementMap in="SourceGraphic" scale="2.2" />
    </filter>
  ))}
</svg>
