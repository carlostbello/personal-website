---
// Dev-only: try accent colors live. Remove once one is picked.
export const accents = {
  tangerine: '#ff7a1a',
  amber: '#f0953f',
  marigold: '#f3b53f',
  tomato: '#ee5a3f',
  mint: '#7dd3b0',
  bubblegum: '#f49ac1',
};
---
<div class="picker" role="group" aria-label="Accent color">
  {Object.entries(accents).map(([name, hex]) => (
    <button type="button" data-pick={name} style={`--c:${hex}`} title={`${name} ${hex}`}>
      <span>{name}</span>
    </button>
  ))}
</div>

<script is:inline define:vars={{ accents }}>
  const KEY = 'accent';
  const apply = () => {
    const name = localStorage.getItem(KEY);
    const hex = accents[name];
    document.documentElement.style.setProperty('--accent', hex ?? null);
    document.querySelectorAll('[data-pick]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.pick === (hex ? name : 'tangerine'))),
    );
  };
  apply();
  document.addEventListener('astro:after-swap', apply);
  document.addEventListener('click', (e) => {
    const b = e.target.closest?.('[data-pick]');
    if (!b) return;
    localStorage.setItem(KEY, b.dataset.pick);
    apply();
  });
</script>

<style>
  .picker {
    position: fixed;
    left: 12px;
    bottom: 12px;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-width: calc(100vw - 24px);
    padding: 8px;
    background: var(--page);
    border: var(--line) solid var(--ink);
  }
  button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 4px;
    border: 2px solid var(--ink);
    background: var(--page);
    font: 400 1rem var(--f-hand);
    color: var(--ink);
    cursor: pointer;
  }
  button::before {
    content: '';
    width: 22px;
    height: 22px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--c);
  }
  button[aria-pressed='true'] {
    background: var(--c);
  }
</style>
