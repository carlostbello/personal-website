---
// Pressure over time for one shot. Placeholder curve until real logs exist.
const curve = 'M20 150 C46 150 54 140 66 96 S86 46 104 44 L196 46 C214 48 222 92 240 124';
---
<svg viewBox="0 0 260 180" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" data-ink aria-hidden="true">
  <path d="M20 12v146h228" />
  <path d="M14 44h12M14 96h12" />
  <path d={curve} stroke="var(--accent)" stroke-width="5" />
  <circle r="6" fill="var(--ink)" stroke="none" class="bead">
    <animateMotion dur="3.2s" repeatCount="indefinite" path={curve} />
  </circle>
  <text x="30" y="40" fill="var(--ink)" stroke="none" font-family="Patrick Hand" font-size="16">9 bar</text>
  <text x="210" y="174" fill="var(--ink)" stroke="none" font-family="Patrick Hand" font-size="16">28s</text>
</svg>

<style>
  @media (prefers-reduced-motion: reduce) {
    .bead {
      display: none;
    }
  }
</style>
