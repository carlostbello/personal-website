---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, blurb, year, links } = project.data;
---
<Base title={title} description={blurb}>
  <article class="wrap" data-pagefind-body>
    <header>
      <h1 class="lettering" transition:name={`project-${project.id}`}>{title}</h1>
      <p class="blurb">{blurb}</p>
      <p class="meta">
        <span>{year}</span>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </p>
    </header>
    <div class="panel prose-panel">
      <div class="prose"><Content /></div>
    </div>
    <a class="back" href="/projects" data-pagefind-ignore>← All projects</a>
  </article>
</Base>

<style>
  header {
    padding-block: 32px 36px;
    max-width: 900px;
  }
  h1 {
    font-size: clamp(3rem, 9vw, 6.5rem);
    margin-bottom: 18px;
  }
  .blurb {
    font-size: 1.3rem;
    font-weight: 700;
    max-width: 44ch;
  }
  .meta {
    display: flex;
    gap: 20px;
    font-family: var(--f-hand);
    font-size: 1.25rem;
  }
  .prose-panel {
    max-width: 900px;
  }
  .back {
    display: inline-block;
    margin-top: 24px;
    font-weight: 700;
  }
</style>
