---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getPosts, tagSlug } from '../../lib/posts';
import { site } from '../../lib/site';

const posts = await getPosts();
const byYear = Map.groupBy(posts, (p) => p.data.date.getUTCFullYear());
const tagCounts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1));
const tags = [...tagCounts].sort((a, b) => b[1] - a[1]);
---
<Base title="Log" description="TK Writing by Carlos Bello on AI security, offline systems and the things on his bench.">
  <PageHead title="The log" say="TK Notes, write-ups and the occasional rant." />
  <div class="wrap">
    <div class="tools">
      <form class="search" action="/search" role="search">
        <label class="sr-only" for="log-q">Search the log</label>
        <input id="log-q" name="q" type="search" placeholder="Search the log" />
        <button type="submit">Find</button>
      </form>
      <p class="follow">
        Follow by <a href="/rss.xml">RSS</a>{site.substack && <> or on <a href={site.substack}>Substack</a></>}.
      </p>
    </div>

    {tags.length > 0 && (
      <ul class="tags" aria-label="Topics">
        {tags.map(([t, n]) => (
          <li><a href={`/log/tags/${tagSlug(t)}`}>{t} <span>{n}</span></a></li>
        ))}
      </ul>
    )}

    {[...byYear].map(([year, list]) => (
      <section class="year">
        <h2 class="lettering">{year}</h2>
        <PostList posts={list} />
      </section>
    ))}

    <Newsletter />
  </div>
</Base>

<style>
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .search {
    display: flex;
    flex: 1 1 320px;
    max-width: 520px;
  }
  .search input {
    flex: 1;
    font: inherit;
    padding: 10px 14px;
    border: var(--line) solid var(--ink);
    border-right: 0;
  }
  .search button {
    font: 400 1.2rem var(--f-hand);
    padding: 6px 18px;
    background: var(--accent);
    border: var(--line) solid var(--ink);
    cursor: pointer;
  }
  .follow {
    margin: 0;
    font-weight: 700;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0 0 36px;
  }
  .tags a {
    display: inline-block;
    background: var(--page);
    color: var(--ink);
    border: 2px solid var(--ink);
    padding: 2px 12px;
    font-family: var(--f-hand);
    font-size: 1.15rem;
    text-decoration: none;
    transition: transform 0.2s var(--pop);
  }
  .tags a:hover {
    transform: rotate(-3deg);
    background: var(--accent);
  }
  .tags span {
    opacity: 0.6;
  }
  .year {
    display: grid;
    grid-template-columns: 160px minmax(0, 860px);
    gap: var(--gutter);
    align-items: start;
    margin-bottom: 36px;
  }
  .year h2 {
    font-size: 2.6rem;
    position: sticky;
    top: 16px;
  }
  @media (max-width: 720px) {
    .year {
      grid-template-columns: 1fr;
    }
    .year h2 {
      position: static;
    }
  }
</style>
