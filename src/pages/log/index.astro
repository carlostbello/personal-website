---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

const posts = (await getCollection('log', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const byYear = Map.groupBy(posts, (p) => p.data.date.getFullYear());
const fmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Log" description="TK Writing by Carlos Bello on AI security, offline systems and the things on his bench.">
  <PageHead title="The log" say="TK Notes, write-ups and the occasional rant." />
  <div class="wrap">
    {[...byYear].map(([year, list]) => (
      <section class="year">
        <h2 class="lettering">{year}</h2>
        <ol class="panel">
          {list.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
              <div>
                <a href={`/log/${post.id}`}>{post.data.title}</a>
                <p>{post.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
    <p class="rss">Follow along by <a href="/rss.xml">RSS</a>.</p>
  </div>
</Base>

<style>
  .year {
    display: grid;
    grid-template-columns: 160px minmax(0, 860px);
    gap: var(--gutter);
    align-items: start;
    margin-bottom: 36px;
  }
  .year h2 {
    font-size: 2.6rem;
    position: sticky;
    top: 16px;
  }
  ol {
    list-style: none;
    margin: 0;
  }
  li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    padding-block: 12px;
  }
  li + li {
    border-top: 2px dashed var(--ink);
  }
  time {
    font-family: var(--f-hand);
    font-size: 1.15rem;
  }
  a {
    font-weight: 700;
    font-size: 1.2rem;
  }
  li p {
    margin: 2px 0 0;
    color: var(--ink-soft);
  }
  .rss {
    font-weight: 700;
  }
  @media (max-width: 720px) {
    .year {
      grid-template-columns: 1fr;
    }
    .year h2 {
      position: static;
    }
  }
</style>
