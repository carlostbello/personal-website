---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('log', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, tags } = post.data;
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 230));

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={title} description={description} type="article" published={date} jsonLd={ld}>
  <article class="wrap">
    <header>
      <p class="meta">
        <time datetime={date.toISOString()}>{fmt.format(date)}</time>
        <span>{minutes} min read</span>
      </p>
      <h1 class="lettering">{title}</h1>
      <p class="dek">{description}</p>
    </header>
    <div class="panel page">
      <div class="prose"><Content /></div>
    </div>
    <footer class="after">
      {tags.length > 0 && <p class="tags">Filed under {tags.join(', ')}</p>}
      <a href="/log">← Back to the log</a>
    </footer>
  </article>
  <div class="progress" aria-hidden="true"></div>
</Base>

<style>
  header {
    max-width: 920px;
    padding-block: 28px 36px;
  }
  .meta {
    display: flex;
    gap: 18px;
    font-family: var(--f-hand);
    font-size: 1.25rem;
    margin-bottom: 10px;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    margin-bottom: 18px;
  }
  .dek {
    font-size: 1.25rem;
    max-width: 50ch;
  }
  .page {
    max-width: 920px;
    padding-inline: clamp(18px, 5vw, 60px);
    padding-block: clamp(24px, 4vw, 48px);
  }
  .after {
    max-width: 920px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
    font-weight: 700;
  }
  /* Reading progress, driven by scroll where supported. */
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 6px;
    background: var(--orange);
    transform-origin: left;
    transform: scaleX(0);
    z-index: 30;
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      animation: read linear both;
      animation-timeline: scroll(root);
    }
    @keyframes read {
      to {
        transform: scaleX(1);
      }
    }
  }
</style>
