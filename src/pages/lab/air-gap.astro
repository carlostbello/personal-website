---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Narrator from '../../components/Narrator.astro';
import AirGap from '../../components/drawings/AirGap.astro';
import Rack from '../../components/drawings/Rack.astro';
import Espresso from '../../components/drawings/Espresso.astro';
import SignalPath from '../../components/drawings/SignalPath.astro';
import avatar from '../../assets/avatar.png';
import { home } from '../../lib/copy';
import { getPosts } from '../../lib/posts';
import PostList from '../../components/PostList.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);

const drawings = [Rack, Espresso, SignalPath];

---
<Base title="Lab: Air gap" noindex>
  <section class="hero wrap" data-hero>
    <h1 class="lettering name">
      <span>Carlos</span>
      <span>Bello</span>
    </h1>
    <p class="role">{home.role}</p>
    <div class="who" data-lean>
      <p class="balloon hello">{home.hello}</p>
      <Image src={avatar} alt="Cartoon of Carlos grinning with his arms crossed" width={420} height={420} loading="eager" class="me" />
    </div>
  </section>

  <section class="work wrap" data-say={home.narrator.work}>
    <div class="panel work-panel">
      <span class="caption">{home.work.caption}</span>
      <h2 class="lettering">{home.work.heading}</h2>
      <div class="work-text">
        {home.work.body.map((p) => <p>{p}</p>)}
        <a class="more" href="/talks">{home.work.talksLink}</a>
      </div>
    </div>
    <div class="sheet-wrap">
      <div class="sheet" data-airgap>
        <div class="sheet-fallback panel"><AirGap /></div>
        <canvas aria-hidden="true"></canvas>
      </div>
      <button type="button" class="send" data-send hidden>Try to send one out</button>
    </div>
  </section>

  <section class="lab wrap" data-say={home.narrator.lab}>
    <h2 class="lettering section-head">{home.lab.heading}</h2>
    <div class="strip">
      {home.lab.panels.map((p, i) => {
        const Drawing = drawings[i];
        return (
          <a class="panel strip-panel" href={p.href}>
            <span class="caption">{p.caption}</span>
            <Drawing />
            <p>{p.line}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="projects wrap" data-say={home.narrator.projects}>
    <h2 class="lettering section-head">{home.projects.heading}</h2>
    <div class="project-grid">
      {projects.map((p) => (
        <a class:list={['panel', 'project', p.data.size]} href={`/projects/${p.id}`}>
          <h3 transition:name={`project-${p.id}`}>{p.data.title}</h3>
          <p>{p.data.blurb}</p>
          <span class="year">{p.data.year}</span>
        </a>
      ))}
    </div>
    <a class="more on-field" href="/projects">{home.projects.all}</a>
  </section>

  <section class="log wrap" data-say={home.narrator.log}>
    <h2 class="lettering section-head">{home.log.heading}</h2>
    <div class="posts"><PostList posts={posts} showYear /></div>
    <a class="more on-field" href="/log">{home.log.all}</a>
  </section>

  <Narrator quips={home.quips} />
</Base>

<script>
  // The sheet (and three.js with it) only loads once it is near the screen,
  // and never under reduced motion: then the inked drawing stays.
  let cleanup: (() => void) | null = null;
  let io: IntersectionObserver | null = null;
  let alive = 0;

  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-airgap]');
    if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const ticket = ++alive;
    io = new IntersectionObserver(
      async ([e]) => {
        if (!e.isIntersecting) return;
        io?.disconnect();
        try {
          const { mountAirGap } = await import('../../lab/air-gap/scene');
          if (ticket !== alive) return;
          const done = await mountAirGap(el);
          if (ticket === alive) cleanup = done;
          else done();
        } catch {
          el.classList.add('no-gl');
        }
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(el);
  });

  document.addEventListener('astro:before-swap', () => {
    alive++;
    io?.disconnect();
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 400px);
    grid-template-rows: 1fr auto;
    align-items: end;
    min-height: min(72vh, 660px);
    padding-top: 24px;
    border-bottom: var(--line) solid var(--ink);
  }
  .name {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    font-size: clamp(4rem, 11.5vw, 10rem);
  }
  .name span {
    display: block;
    animation: stamp 0.5s var(--pop) both;
  }
  .name span:nth-child(2) {
    animation-delay: 0.12s;
    padding-left: 0.4em;
  }
  @keyframes stamp {
    from {
      transform: scale(1.35) rotate(-4deg);
      opacity: 0;
    }
  }
  .role {
    grid-column: 1;
    grid-row: 2;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 28px;
    animation: rise 0.5s var(--snap) 0.35s both;
  }
  .who {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    transform: rotate(var(--lean, 0deg)) translateY(var(--shift, 0));
    transform-origin: 50% 100%;
    transition: transform 0.4s var(--snap);
  }
  .me {
    width: 100%;
    height: auto;
    margin-bottom: -2px; /* sit on the hero's ink floor */
    animation: rise 0.7s var(--pop) 0.2s both;
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
      opacity: 0;
    }
  }
  .hello {
    position: absolute;
    left: -34%;
    top: 12%;
    max-width: 250px;
    z-index: 2;
    animation: pop-in 0.4s var(--pop) 0.75s both;
    transform-origin: 80% 100%;
  }
  @keyframes pop-in {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  /* ---------- shared ---------- */
  section + section {
    margin-top: clamp(64px, 10vw, 120px);
  }
  .section-head {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 26px;
  }
  .more {
    display: inline-block;
    margin-top: 18px;
    font-weight: 700;
  }
  .more::after {
    content: ' →';
  }

  /* ---------- work: the copy in a panel, the diagram on a sheet ---------- */
  .work-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(16px, 4vw, 48px);
    align-items: start;
    padding-top: 56px;
    max-width: 980px;
  }
  .work-panel h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .work-text p:last-of-type {
    margin-bottom: 0;
  }
  .sheet-wrap {
    margin-top: clamp(20px, 3vw, 32px);
  }
  .sheet {
    position: relative;
  }
  .sheet canvas {
    display: none;
  }
  /* With JS and motion, reserve the sheet's box up front so nothing jumps
     when the paper takes over from the drawing. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .sheet:not(.no-gl) {
      aspect-ratio: 1200 / 560;
    }
    :global(.js) .sheet:not(.no-gl) .sheet-fallback {
      height: 100%;
      display: grid;
      place-items: center;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 640px) {
    :global(.js) .sheet:not(.no-gl) {
      aspect-ratio: 600 / 1040;
    }
  }
  .sheet.live .sheet-fallback,
  :global(.js) .sheet.live .sheet-fallback {
    display: none;
  }
  .sheet.live canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    touch-action: pan-y;
  }
  .sheet-fallback :global(svg) {
    width: 100%;
  }
  .send {
    display: block;
    margin: 14px 0 0;
    font-family: var(--f-hand);
    font-size: 1.2rem;
    line-height: 1.1;
    color: var(--ink);
    background: var(--accent);
    border: var(--line) solid var(--ink);
    padding: 7px 16px 6px;
    cursor: pointer;
    transition: transform 0.15s var(--pop);
  }
  .send:hover {
    transform: rotate(-2deg);
  }
  .send:active {
    transform: scale(0.94);
  }
  .send[hidden] {
    display: none;
  }

  /* ---------- lab strip: uneven panels, like a comic row ---------- */
  .strip {
    display: grid;
    grid-template-columns: 1.15fr 1.4fr 1fr;
    gap: var(--gutter);
  }
  .strip-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 52px;
    text-decoration: none;
    transition: transform 0.3s var(--pop);
  }
  .strip-panel:nth-child(1) {
    transform: rotate(-0.8deg);
  }
  .strip-panel:nth-child(3) {
    transform: rotate(0.7deg);
    background: var(--accent);
  }
  .strip-panel:hover {
    transform: rotate(0deg) translateY(-6px);
  }
  .strip-panel :global(svg) {
    width: 100%;
    max-height: 190px;
    margin-block: 8px 14px;
  }
  .strip-panel p {
    margin: 0;
  }

  /* ---------- projects ---------- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--gutter);
  }
  .project {
    grid-column: span 3;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    min-height: 200px;
  }
  .project.wide {
    grid-column: span 6;
    background: var(--accent);
    min-height: 240px;
  }
  .project h3 {
    font-family: var(--f-letter);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    margin-bottom: 12px;
  }
  .project.wide h3 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
  }
  .project p {
    max-width: 52ch;
  }
  .year {
    margin-top: auto;
    font-family: var(--f-hand);
    font-size: 1.2rem;
  }
  .project:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 5px;
  }
  .project.wide:hover h3 {
    text-decoration-color: var(--ink);
  }
  .on-field {
    color: var(--page);
  }

  /* ---------- log ---------- */
  .posts {
    max-width: 820px;
  }

  /* ---------- small screens ---------- */
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      min-height: 0;
    }
    .name,
    .role,
    .who {
      grid-column: 1;
      grid-row: auto;
    }
    .role {
      font-size: 1.1rem;
      margin-bottom: 8px;
    }
    .who {
      width: min(300px, 70%);
      justify-self: end;
      margin-top: 40px;
    }
    .hello {
      left: -32%;
      top: -10%;
      max-width: 190px;
      font-size: 1.05rem;
      padding: 14px 22px;
    }
    .work-panel,
    .strip {
      grid-template-columns: 1fr;
    }
    .project,
    .project.wide {
      grid-column: span 6;
    }
  }
</style>
