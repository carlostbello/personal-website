---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Narrator from '../../components/Narrator.astro';
import AirGap from '../../components/drawings/AirGap.astro';
import Rack from '../../components/drawings/Rack.astro';
import Espresso from '../../components/drawings/Espresso.astro';
import SignalPath from '../../components/drawings/SignalPath.astro';
import avatar from '../../assets/avatar.png';
import { home } from '../../lib/copy';
import { getPosts } from '../../lib/posts';
import PostList from '../../components/PostList.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
const drawings = [Rack, Espresso, SignalPath];
const words = ['Carlos', 'Bello'];
const passes = ['Pencils', 'Inks', 'Flats', 'Print'];

// Construction lines over the avatar, in the PNG's own 834px space.
const construct = [
  'M455 330m-188 0a188 188 0 1 0 376 0a188 188 0 1 0 -376 0',
  'M470 118 Q492 330 462 560',
  'M262 372 L652 346',
  'M360 446 L612 430',
  'M362 470 L340 580 M512 488 L526 572',
  'M60 834 Q110 590 336 556 L540 552 Q720 566 790 834',
  'M110 806 Q430 742 752 800',
  'M300 392 a34 40 0 1 0 1 0',
];
---
<Base title="Lab: Pencils, inks, colors" noindex>
  <section class="hero wrap" data-hero data-pencils>
    <div class="board" aria-hidden="true">
      <span class="flood"></span>
      <span class="crop tl"></span><span class="crop tr"></span><span class="crop bl"></span><span class="crop br"></span>
    </div>

    <div class="tag" data-tag hidden>
      <div class="tag-intro">
        <span class="tag-now" data-now aria-live="polite">Pencils — 1 of 4</span>
        <button type="button" class="tag-skip" data-skip>Skip</button>
      </div>
      <div class="tag-controls" role="group" aria-label="Show a production pass">
        {passes.map((name) => <button type="button" data-pass aria-pressed="false">{name}</button>)}
      </div>
    </div>

    <p class="hint" data-hint hidden>Hover over me to see the pencils.</p>

    <h1 class="lettering name">
      {words.map((w) => (
        <span class="word">
          <span class="w-pencil" data-t={w} aria-hidden="true">{w}</span>
          <span class="w-ink">{w}</span>
        </span>
      ))}
    </h1>
    <p class="role">{home.role}</p>
    <div class="who" data-lean>
      <p class="balloon hello">{home.hello}</p>
      <div class="art">
        <span class="dots" aria-hidden="true"></span>
        <Image src={avatar} alt="Cartoon of Carlos grinning with his arms crossed" width={420} height={420} loading="eager" class="me" />
        <canvas class="passes" data-src={avatar.src} aria-hidden="true"></canvas>
        <svg class="construct" viewBox="0 0 834 834" aria-hidden="true">
          {construct.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
        </svg>
      </div>
    </div>
    <span class="floor" aria-hidden="true"></span>
  </section>
  <script is:inline>
    // Hold the hero on a blank board before first paint if the intro will play.
    (function () {
      var h = document.querySelector('[data-pencils]');
      if (!h || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      try {
        if (sessionStorage.getItem('lab-pencils-seen') === '1') return;
      } catch (e) {}
      h.setAttribute('data-intro', 'play');
      h.setAttribute('data-stage', '0');
      // Failsafe: if the script never arrives, show the finished page.
      setTimeout(function () {
        if (h.getAttribute('data-stage') === '0') {
          h.removeAttribute('data-stage');
          h.removeAttribute('data-intro');
        }
      }, 3000);
    })();
  </script>

  <section class="work wrap" data-say={home.narrator.work}>
    <div class="panel work-panel">
      <span class="caption">{home.work.caption}</span>
      <div class="work-text">
        <h2 class="lettering">{home.work.heading}</h2>
        {home.work.body.map((p) => <p>{p}</p>)}
        <a class="more" href="/talks">{home.work.talksLink}</a>
      </div>
      <AirGap />
    </div>
  </section>

  <section class="lab wrap" data-say={home.narrator.lab}>
    <h2 class="lettering section-head">{home.lab.heading}</h2>
    <div class="strip">
      {home.lab.panels.map((p, i) => {
        const Drawing = drawings[i];
        return (
          <a class="panel strip-panel" href={p.href}>
            <span class="caption">{p.caption}</span>
            <Drawing />
            <p>{p.line}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="projects wrap" data-say={home.narrator.projects}>
    <h2 class="lettering section-head">{home.projects.heading}</h2>
    <div class="project-grid">
      {projects.map((p) => (
        <a class:list={['panel', 'project', p.data.size]} href={`/projects/${p.id}`}>
          <h3>{p.data.title}</h3>
          <p>{p.data.blurb}</p>
          <span class="year">{p.data.year}</span>
        </a>
      ))}
    </div>
    <a class="more on-field" href="/projects">{home.projects.all}</a>
  </section>

  <section class="log wrap" data-say={home.narrator.log}>
    <h2 class="lettering section-head">{home.log.heading}</h2>
    <div class="posts"><PostList posts={posts} showYear /></div>
    <a class="more on-field" href="/log">{home.log.all}</a>
  </section>

  <Narrator quips={home.quips} />
</Base>

<script>
  import '../../lab/pencils/intro';
</script>

<style>
  @property --dot {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 30%;
  }

  /* ---------- hero ---------- */
  .hero {
    /* Non-photo blue, mixed from the field token. */
    --pencil: color-mix(in srgb, var(--field) 52%, var(--page));
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 400px);
    grid-template-rows: 1fr auto;
    align-items: end;
    min-height: min(72vh, 660px);
    padding-top: 64px;
    border-bottom: var(--line) solid var(--ink);
  }
  .name {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    font-size: clamp(4rem, 11.5vw, 10rem);
  }
  .word {
    position: relative;
    display: block;
  }
  .word:nth-child(2) {
    padding-left: 0.4em;
  }
  .w-pencil,
  .construct,
  .floor,
  .board {
    display: none;
  }
  .role {
    grid-column: 1;
    grid-row: 2;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 28px;
  }
  .who {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    transform: rotate(var(--lean, 0deg)) translateY(var(--shift, 0));
    transform-origin: 50% 100%;
    transition: transform 0.4s var(--snap);
  }
  .art {
    position: relative;
    margin-bottom: -2px; /* sit on the hero's ink floor */
  }
  .me {
    width: 100%;
    height: auto;
  }
  .passes {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .gl .passes {
    display: block;
  }
  .gl .me {
    opacity: 0;
  }
  /* Ben-Day shading behind his head: the last thing the press adds. */
  .dots {
    position: absolute;
    inset: -4% -12% 30% 2%;
    z-index: -1;
    background: radial-gradient(circle, var(--field-deep) var(--dot), transparent calc(var(--dot) + 3%)) 0 0 / 14px 14px;
    mask-image: radial-gradient(closest-side, #000 25%, transparent 100%);
    transition: --dot 0.9s var(--snap);
  }
  .hello {
    position: absolute;
    left: -34%;
    top: 12%;
    max-width: 250px;
    z-index: 2;
    transform-origin: 80% 100%;
  }
  .hint {
    position: absolute;
    left: 6px;
    top: 52px;
    margin: 0;
    font-family: var(--f-hand);
    font-size: 1.05rem;
    color: var(--page);
  }

  /* Without the intro (no JS, seen this session): the homepage's own entrance. */
  .hero:not([data-intro='play'], [data-intro='played']) .word {
    animation: stamp 0.5s var(--pop) both;
  }
  .hero:not([data-intro='play'], [data-intro='played']) .word:nth-child(2) {
    animation-delay: 0.12s;
  }
  .hero:not([data-intro='play'], [data-intro='played']) .role {
    animation: rise 0.5s var(--snap) 0.35s both;
  }
  .hero:not([data-intro='play'], [data-intro='played']) .art {
    animation: rise 0.7s var(--pop) 0.2s both;
  }
  .hero:not([data-intro='play'], [data-intro='played']) .hello {
    animation: pop-in 0.4s var(--pop) 0.75s both;
  }
  @keyframes stamp {
    from {
      transform: scale(1.35) rotate(-4deg);
      opacity: 0;
    }
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
      opacity: 0;
    }
  }
  @keyframes pop-in {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  /* ---------- the tag: caption box during the intro, pass switcher after ---------- */
  .tag {
    position: absolute;
    top: 8px;
    left: 0;
    z-index: 5;
    background: var(--accent);
    color: var(--ink);
    border: var(--line) solid var(--ink);
    font-family: var(--f-hand);
    font-size: 1.1rem;
    line-height: 1.1;
    transform: rotate(-1.2deg);
  }
  .tag[hidden] {
    display: none;
  }
  .tag-intro,
  .tag-controls {
    display: flex;
    align-items: stretch;
  }
  .tag[data-mode='intro'] .tag-controls,
  .tag[data-mode='controls'] .tag-intro {
    display: none;
  }
  .tag-now {
    padding: 6px 12px 5px;
    min-width: 9.5em;
  }
  .tag-now.pop {
    animation: pop-in 0.3s var(--pop);
  }
  .tag button {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 0;
    border-left: var(--line) solid var(--ink);
    padding: 6px 12px 5px;
    cursor: pointer;
  }
  .tag-controls button:first-child {
    border-left: 0;
  }
  .tag button:hover {
    background: var(--page);
  }
  .tag button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--accent);
  }
  .tag button:focus-visible {
    outline-offset: -6px;
    outline-color: var(--ink);
  }
  .tag button[aria-pressed='true']:focus-visible {
    outline-color: var(--accent);
  }

  /* ---------- production stages (data-stage 0..4; 4 = the finished page) ---------- */
  .hero[data-stage] {
    border-bottom-color: transparent;
  }
  .hero[data-stage] :is(.w-pencil, .construct, .floor, .board) {
    display: block;
  }

  /* the board: a sheet of bristol on the blue desk, flooded blue at flats */
  .board {
    position: absolute;
    inset: 0 -14px 0;
    z-index: -2;
    background: var(--page);
    transition: opacity 0.5s;
  }
  .flood {
    position: absolute;
    inset: 0;
    background: var(--field);
    clip-path: circle(0% at 74% 56%);
    transition: clip-path 0.85s var(--snap);
  }
  .crop {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 0 solid var(--pencil);
  }
  .crop.tl {
    top: 8px;
    left: 8px;
    border-width: 2px 0 0 2px;
  }
  .crop.tr {
    top: 8px;
    right: 8px;
    border-width: 2px 2px 0 0;
  }
  .crop.bl {
    bottom: 8px;
    left: 8px;
    border-width: 0 0 2px 2px;
  }
  .crop.br {
    bottom: 8px;
    right: 8px;
    border-width: 0 2px 2px 0;
  }
  .hero:is([data-stage='3'], [data-stage='4']) .flood {
    clip-path: circle(150% at 74% 56%);
  }
  .hero[data-stage='4'] .board {
    opacity: 0;
  }

  /* lettering: guides and blue roughs, then the pen, then the marigold flat */
  .w-pencil {
    position: absolute;
    inset: 0;
    z-index: -1;
    padding-left: inherit;
    color: transparent;
    -webkit-text-stroke: 2px var(--pencil);
    clip-path: inset(-0.2em calc(100% + 0.2em) -0.2em -0.2em);
    transition:
      clip-path 1.1s cubic-bezier(0.5, 0, 0.3, 1),
      opacity 0.5s;
  }
  .w-pencil::after {
    content: attr(data-t);
    position: absolute;
    inset: 0;
    padding-left: inherit;
    transform: translate(0.025em, -0.02em) rotate(-0.5deg);
    opacity: 0.7;
  }
  .word:nth-child(2) .w-pencil {
    transition-delay: 0.25s, 0s;
  }
  .hero[data-stage] .word::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: -8px;
    right: 0;
    top: 0.08em;
    bottom: 0.1em;
    border-block: 1.5px solid var(--pencil);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition:
      transform 0.8s var(--snap),
      opacity 0.5s;
  }
  .hero[data-stage] .w-ink {
    clip-path: inset(-0.2em calc(100% + 0.2em) -0.2em -0.2em);
    color: var(--page);
    transition:
      clip-path 0.9s cubic-bezier(0.6, 0, 0.4, 1),
      color 0.45s;
  }
  .hero[data-stage] .word:nth-child(2) .w-ink {
    transition-delay: 0.2s, 0s;
  }
  .hero:not([data-stage='0']) .w-pencil {
    clip-path: inset(-0.2em -0.2em -0.2em -0.2em);
  }
  .hero:not([data-stage='0']) .word::before {
    transform: none;
  }
  .hero:is([data-stage='2'], [data-stage='3'], [data-stage='4']) .w-ink {
    clip-path: inset(-0.2em -0.2em -0.2em -0.2em);
  }
  .hero:is([data-stage='3'], [data-stage='4']) .w-ink {
    color: var(--accent);
  }
  .hero:is([data-stage='3'], [data-stage='4']) .w-pencil,
  .hero:is([data-stage='3'], [data-stage='4']) .word::before {
    opacity: 0;
  }

  /* role line and balloon */
  .hero[data-stage] .role {
    transition:
      color 0.5s,
      opacity 0.4s;
  }
  .hero[data-stage='0'] .role,
  .hero[data-stage='0'] .hello {
    opacity: 0;
  }
  .hero[data-stage='1'] .role {
    color: var(--pencil);
  }
  .hero[data-stage='2'] .role {
    color: var(--ink);
  }
  .hero[data-stage] .hello {
    transition:
      color 0.5s,
      background-color 0.5s,
      opacity 0.4s;
  }
  .hero[data-stage] .hello::before {
    transition: border-color 0.5s;
  }
  .hero[data-stage='1'] .hello {
    color: var(--pencil);
    background-color: transparent;
  }
  .hero[data-stage='1'] .hello::before {
    border-color: var(--pencil);
    border-width: 2px;
  }
  .hero[data-stage='1'] .hello::after {
    filter: drop-shadow(2px 0 0 var(--pencil)) drop-shadow(-2px 0 0 var(--pencil)) drop-shadow(0 2px 0 var(--pencil));
  }

  /* construction lines on the avatar */
  .construct {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--pencil);
    stroke-width: 3;
    stroke-linecap: round;
    transition: opacity 0.5s;
  }
  .construct path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.7s cubic-bezier(0.5, 0, 0.3, 1) calc(var(--i) * 70ms);
  }
  .hero:not([data-stage='0']) .construct path {
    stroke-dashoffset: 0;
  }
  .hero:is([data-stage='3'], [data-stage='4']) .construct {
    opacity: 0;
  }
  /* No WebGL: the art itself waits for the inks. */
  .hero:is([data-stage='0'], [data-stage='1']) .who:not(.gl) .me {
    opacity: 0;
  }
  .who:not(.gl) .me {
    transition: opacity 0.6s;
  }
  .hero:is([data-stage='0'], [data-stage='1'], [data-stage='2'], [data-stage='3']) .dots {
    --dot: 0%;
  }

  /* the floor: a ruled pencil line, then the inked one */
  .floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * var(--line));
    height: var(--line);
  }
  .floor::before,
  .floor::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .floor::before {
    left: -10px;
    right: -10px;
    height: 2px;
    top: 1px;
    background: var(--pencil);
    transform: scaleX(0) rotate(-0.15deg);
    transform-origin: 0 50%;
    transition:
      transform 0.9s var(--snap),
      opacity 0.5s;
  }
  .floor::after {
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.9s cubic-bezier(0.6, 0, 0.4, 1);
  }
  .hero:not([data-stage='0']) .floor::before {
    transform: rotate(-0.15deg);
  }
  .hero:is([data-stage='2'], [data-stage='3'], [data-stage='4']) .floor::after {
    transform: none;
  }
  .hero:is([data-stage='3'], [data-stage='4']) .floor::before {
    opacity: 0;
  }

  /* ---------- the rest of the page: panels ink over a pencil rough ---------- */
  .panel[data-rough] {
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--field) 52%, var(--page));
  }
  .panel[data-rough]::before {
    clip-path: inset(0 100% 100% 0);
  }
  .panel[data-rough].drawn::before {
    animation:
      boil 0.375s steps(1) infinite,
      trace 0.6s cubic-bezier(0.5, 0, 0.3, 1) 0.1s both;
  }
  @keyframes trace {
    from {
      clip-path: inset(0 100% 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* ---------- shared ---------- */
  section + section {
    margin-top: clamp(64px, 10vw, 120px);
  }
  .section-head {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 26px;
  }
  .more {
    display: inline-block;
    margin-top: 18px;
    font-weight: 700;
  }
  .more::after {
    content: ' →';
  }

  /* ---------- work ---------- */
  .work-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    padding-top: 56px;
  }
  .work-panel h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 18px;
  }

  /* ---------- lab strip ---------- */
  .strip {
    display: grid;
    grid-template-columns: 1.15fr 1.4fr 1fr;
    gap: var(--gutter);
  }
  .strip-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 52px;
    text-decoration: none;
    transition: transform 0.3s var(--pop);
  }
  .strip-panel:nth-child(1) {
    transform: rotate(-0.8deg);
  }
  .strip-panel:nth-child(3) {
    transform: rotate(0.7deg);
    background: var(--accent);
  }
  .strip-panel:hover {
    transform: rotate(0deg) translateY(-6px);
  }
  .strip-panel :global(svg) {
    width: 100%;
    max-height: 190px;
    margin-block: 8px 14px;
  }
  .strip-panel p {
    margin: 0;
  }

  /* ---------- projects ---------- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--gutter);
  }
  .project {
    grid-column: span 3;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    min-height: 200px;
  }
  .project.wide {
    grid-column: span 6;
    background: var(--accent);
    min-height: 240px;
  }
  .project h3 {
    font-family: var(--f-letter);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    margin-bottom: 12px;
  }
  .project.wide h3 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
  }
  .project p {
    max-width: 52ch;
  }
  .year {
    margin-top: auto;
    font-family: var(--f-hand);
    font-size: 1.2rem;
  }
  .project:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 5px;
  }
  .project.wide:hover h3 {
    text-decoration-color: var(--ink);
  }
  .on-field {
    color: var(--page);
  }

  /* ---------- log ---------- */
  .posts {
    max-width: 820px;
  }

  /* ---------- small screens ---------- */
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      min-height: 0;
    }
    .name,
    .role,
    .who {
      grid-column: 1;
      grid-row: auto;
    }
    .role {
      font-size: 1.1rem;
      margin-bottom: 8px;
    }
    .who {
      width: min(300px, 70%);
      justify-self: end;
      margin-top: 40px;
    }
    .hello {
      left: -32%;
      top: -10%;
      max-width: 190px;
      font-size: 1.05rem;
      padding: 14px 22px;
    }
    .board {
      inset: 0 -8px 0;
    }
    .hint {
      display: none;
    }
    .dots {
      right: -4%;
    }
    .tag {
      font-size: 1rem;
    }
    .tag button,
    .tag-now {
      padding-inline: 9px;
    }
    .work-panel,
    .strip {
      grid-template-columns: 1fr;
    }
    .project,
    .project.wide {
      grid-column: span 6;
    }
  }
</style>
