---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Narrator from '../../components/Narrator.astro';
import AirGap from '../../components/drawings/AirGap.astro';
import Rack from '../../components/drawings/Rack.astro';
import Espresso from '../../components/drawings/Espresso.astro';
import SignalPath from '../../components/drawings/SignalPath.astro';
import PostList from '../../components/PostList.astro';
import PanelIndex from '../../lab/panel-nav/PanelIndex.astro';
import Palette from '../../lab/panel-nav/Palette.astro';
import type { Entry } from '../../lab/panel-nav/search';
import avatar from '../../assets/avatar.png';
import { home } from '../../lib/copy';
import { getPosts, dateFmt } from '../../lib/posts';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const allPosts = await getPosts();
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = allProjects.slice(0, 3);
const posts = allPosts.slice(0, 3);

const drawings = [Rack, Espresso, SignalPath];

// The palette's index, built once at build time from the collections.
const index: Entry[] = [
  { title: 'Home', sub: 'Back to the top of this page', href: '#top', terms: 'start top hello', suggest: true },
  { title: 'Projects', sub: 'Every project', href: '/projects', terms: 'work built things', suggest: true },
  { title: 'The log', sub: 'Every post', href: '/log', terms: 'blog posts writing notes', suggest: true },
  { title: 'Talks', sub: 'Conference talks', href: '/talks', terms: 'speaking stage slides video', suggest: true },
  { title: 'Search', sub: 'Full text, all posts', href: '/search', terms: 'find', suggest: false },
  ...allProjects.map((p) => ({
    title: p.data.title,
    sub: `Project, ${p.data.year}`,
    href: `/projects/${p.id}`,
    terms: p.data.blurb,
    suggest: p.data.size === 'wide',
  })),
  ...allPosts.map((p) => ({
    title: p.data.title,
    sub: `Log, ${dateFmt.short.format(p.data.date)}`,
    href: `/log/${p.id}`,
    terms: `${p.data.description} ${p.data.tags.join(' ')}`,
  })),
  ...talks.map((t) => ({
    title: t.data.title,
    sub: `Talk, ${t.data.event}`,
    href: '/talks',
    terms: `${t.data.event} ${t.data.city ?? ''}`,
  })),
];
---
<Base title="Lab: Panel index" noindex>
  <section class="hero wrap" id="top" tabindex="-1" data-hero>
    <h1 class="lettering name">
      <span>Carlos</span>
      <span>Bello</span>
    </h1>
    <p class="role">{home.role}</p>
    <div class="who" data-lean>
      <p class="balloon hello">{home.hello}</p>
      <Image src={avatar} alt="Cartoon of Carlos grinning with his arms crossed" width={420} height={420} loading="eager" class="me" />
    </div>
  </section>

  <PanelIndex />

  <section class="work wrap" data-say={home.narrator.work}>
    <div class="panel work-panel">
      <span class="caption">{home.work.caption}</span>
      <div class="work-text">
        <h2 class="lettering">{home.work.heading}</h2>
        {home.work.body.map((p) => <p>{p}</p>)}
        <a class="more" href="/talks">{home.work.talksLink}</a>
      </div>
      <AirGap />
    </div>
  </section>

  <section class="lab wrap" data-say={home.narrator.lab}>
    <h2 class="lettering section-head">{home.lab.heading}</h2>
    <div class="strip">
      {home.lab.panels.map((p, i) => {
        const Drawing = drawings[i];
        return (
          <a class="panel strip-panel" href={p.href}>
            <span class="caption">{p.caption}</span>
            <Drawing />
            <p>{p.line}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="projects wrap" id="projects" tabindex="-1" data-say={home.narrator.projects}>
    <h2 class="lettering section-head">{home.projects.heading}</h2>
    <div class="project-grid">
      {projects.map((p) => (
        <a class:list={['panel', 'project', p.data.size]} href={`/projects/${p.id}`}>
          <h3 transition:name={`project-${p.id}`}>{p.data.title}</h3>
          <p>{p.data.blurb}</p>
          <span class="year">{p.data.year}</span>
        </a>
      ))}
    </div>
    <a class="more on-field" href="/projects">{home.projects.all}</a>
  </section>

  <section class="log wrap" id="log" tabindex="-1" data-say={home.narrator.log}>
    <h2 class="lettering section-head">{home.log.heading}</h2>
    <div class="posts"><PostList posts={posts} showYear /></div>
    <a class="more on-field" href="/log">{home.log.all}</a>
  </section>

  <Narrator quips={home.quips} />
  <Palette index={index} />
</Base>

<script>
  import '../../lab/panel-nav/client';
</script>

<style is:global>
  /* ---------- page turn (same-page jumps), scoped to .pn-turn so the
     site's own panel wipe between pages is untouched ---------- */
  html.pn-turn body,
  html.pn-turn body * {
    view-transition-name: none !important;
  }
  html.pn-turn::view-transition-group(root) {
    animation: none;
  }
  html.pn-turn::view-transition-image-pair(root) {
    isolation: auto;
    perspective: 2400px;
  }
  html.pn-turn::view-transition-old(root),
  html.pn-turn::view-transition-new(root) {
    mix-blend-mode: normal;
    backface-visibility: hidden;
    transform-origin: 0 50%;
  }
  /* Forward: the current page lifts off its left edge and swings away,
     uncovering the next one. */
  html.pn-fwd::view-transition-old(root) {
    z-index: 2;
    animation: pn-leaf-off 0.6s cubic-bezier(0.5, 0, 0.3, 1) both;
  }
  html.pn-fwd::view-transition-new(root) {
    z-index: 1;
    animation: pn-under 0.6s cubic-bezier(0.3, 0, 0.2, 1) both;
  }
  /* Back: the earlier page swings back over the top. */
  html.pn-back::view-transition-new(root) {
    z-index: 2;
    animation: pn-leaf-off 0.6s cubic-bezier(0.2, 0.7, 0.3, 1) reverse both;
  }
  html.pn-back::view-transition-old(root) {
    z-index: 1;
    animation: pn-under 0.6s cubic-bezier(0.3, 0, 0.2, 1) reverse both;
  }
  @keyframes pn-leaf-off {
    0% {
      transform: rotateY(0deg);
      filter: brightness(1);
    }
    100% {
      transform: rotateY(-88deg);
      filter: brightness(0.7);
    }
  }
  @keyframes pn-under {
    0% {
      transform: translateX(-2%) scale(0.97);
      filter: brightness(0.6);
    }
    100% {
      transform: none;
      filter: brightness(1);
    }
  }

  /* ---------- corner peel (leaving the page) ---------- */
  .pn-curl {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    view-transition-name: pn-curl;
  }
  .pn-curl-under {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle, var(--field) 1.5px, transparent 2px) 0 0 / 10px 10px,
      var(--field-deep);
    clip-path: polygon(100% 100%, 100% 100%, 100% 100%);
  }
  .pn-curl-edge {
    position: absolute;
    inset: 0;
    filter: drop-shadow(3px 0 0 var(--ink)) drop-shadow(-3px 0 0 var(--ink)) drop-shadow(0 3px 0 var(--ink))
      drop-shadow(0 -3px 0 var(--ink));
  }
  .pn-curl-flap {
    position: absolute;
    inset: 0;
    background: var(--page);
    clip-path: polygon(100% 100%, 100% 100%, 100% 100%);
  }
  ::view-transition-old(pn-curl) {
    animation: pn-curl-out 0.35s ease-in both;
  }
  @keyframes pn-curl-out {
    to {
      opacity: 0;
    }
  }

  html:has(.pn-dialog[open]) {
    overflow: hidden;
  }
</style>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 400px);
    grid-template-rows: 1fr auto;
    align-items: end;
    min-height: min(64vh, 600px);
    padding-top: 24px;
    border-bottom: var(--line) solid var(--ink);
  }
  .name {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    font-size: clamp(4rem, 11.5vw, 10rem);
  }
  .name span {
    display: block;
    animation: stamp 0.5s var(--pop) both;
  }
  .name span:nth-child(2) {
    animation-delay: 0.12s;
    padding-left: 0.4em;
  }
  @keyframes stamp {
    from {
      transform: scale(1.35) rotate(-4deg);
      opacity: 0;
    }
  }
  .role {
    grid-column: 1;
    grid-row: 2;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 28px;
    animation: rise 0.5s var(--snap) 0.35s both;
  }
  .who {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    transform: rotate(var(--lean, 0deg)) translateY(var(--shift, 0));
    transform-origin: 50% 100%;
    transition: transform 0.4s var(--snap);
  }
  .me {
    width: 100%;
    height: auto;
    margin-bottom: -2px; /* sit on the hero's ink floor */
    animation: rise 0.7s var(--pop) 0.2s both;
  }
  @keyframes rise {
    from {
      transform: translateY(40%);
      opacity: 0;
    }
  }
  .hello {
    position: absolute;
    left: -34%;
    top: 12%;
    max-width: 250px;
    z-index: 2;
    animation: pop-in 0.4s var(--pop) 0.75s both;
    transform-origin: 80% 100%;
  }
  @keyframes pop-in {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  [tabindex='-1']:focus {
    outline: none;
  }

  /* ---------- shared ---------- */
  section + section {
    margin-top: clamp(64px, 10vw, 120px);
  }
  .section-head {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 26px;
  }
  .more {
    display: inline-block;
    margin-top: 18px;
    font-weight: 700;
  }
  .more::after {
    content: ' →';
  }

  /* ---------- work ---------- */
  .work-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    padding-top: 56px;
  }
  .work-panel h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 18px;
  }

  /* ---------- lab strip: uneven panels, like a comic row ---------- */
  .strip {
    display: grid;
    grid-template-columns: 1.15fr 1.4fr 1fr;
    gap: var(--gutter);
  }
  .strip-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 52px;
    text-decoration: none;
    transition: transform 0.3s var(--pop);
  }
  .strip-panel:nth-child(1) {
    transform: rotate(-0.8deg);
  }
  .strip-panel:nth-child(3) {
    transform: rotate(0.7deg);
    background: var(--accent);
  }
  .strip-panel:hover {
    transform: rotate(0deg) translateY(-6px);
  }
  .strip-panel :global(svg) {
    width: 100%;
    max-height: 190px;
    margin-block: 8px 14px;
  }
  .strip-panel p {
    margin: 0;
  }

  /* ---------- projects ---------- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--gutter);
  }
  .project {
    grid-column: span 3;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    min-height: 200px;
  }
  .project.wide {
    grid-column: span 6;
    background: var(--accent);
    min-height: 240px;
  }
  .project h3 {
    font-family: var(--f-letter);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    margin-bottom: 12px;
  }
  .project.wide h3 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
  }
  .project p {
    max-width: 52ch;
  }
  .year {
    margin-top: auto;
    font-family: var(--f-hand);
    font-size: 1.2rem;
  }
  .project:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 5px;
  }
  .project.wide:hover h3 {
    text-decoration-color: var(--ink);
  }
  .on-field {
    color: var(--page);
  }

  /* ---------- log ---------- */
  .posts {
    max-width: 820px;
  }

  /* ---------- small screens ---------- */
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      min-height: 0;
    }
    .name,
    .role,
    .who {
      grid-column: 1;
      grid-row: auto;
    }
    .role {
      font-size: 1.1rem;
      margin-bottom: 8px;
    }
    .who {
      width: min(300px, 70%);
      justify-self: end;
      margin-top: 40px;
    }
    .hello {
      left: -32%;
      top: -10%;
      max-width: 190px;
      font-size: 1.05rem;
      padding: 14px 22px;
    }
    .work-panel,
    .strip {
      grid-template-columns: 1fr;
    }
    .project,
    .project.wide {
      grid-column: span 6;
    }
  }
</style>
