---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Narrator from '../../components/Narrator.astro';
import PostList from '../../components/PostList.astro';
import PencilsHero from '../../lab/pencils/PencilsHero.astro';
import PanelIndex from '../../lab/panel-nav/PanelIndex.astro';
import Palette from '../../lab/panel-nav/Palette.astro';
import AfterHours from '../../lab/final/AfterHours.astro';
import { home } from '../../lib/copy';
import { site } from '../../lib/site';
import { getPosts, tagSlug } from '../../lib/posts';

// The picks from the lab, combined: pencils hero and panel index, a plain
// by-day panel, after hours as a picker (coffee, guitars, homelab), then
// the projects and the log.
const allPosts = await getPosts();
const posts = allPosts.slice(0, 3);
const tags = new Set(allPosts.flatMap((p) => p.data.tags.map(tagSlug)));

// Each project card points at its code and at its build journal: the log
// posts tagged with the project's id, when there are any.
const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)
  .map((p) => ({
    ...p,
    code: p.data.links.find((l) => l.href.startsWith('https://github.com/')),
    journal: tags.has(p.id) ? `/log/tags/${p.id}` : undefined,
  }));

const person = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
    sameAs: Object.values(site.social),
  },
};
---
<Base title="Lab: Final" noindex jsonLd={person}>
  <PencilsHero role={home.role} hello={home.hello} />

  <PanelIndex
    items={[
      { label: 'Home', href: '#top' },
      { label: 'Projects', href: '#projects' },
      { label: 'Log', href: '#log' },
      { label: 'Talks', href: '/talks' },
      { label: 'Search', href: '/search', palette: true },
    ]}
  />

  <section class="work wrap beat" data-say={home.narrator.work}>
    <div class="panel work-panel">
      <span class="caption">{home.work.caption}</span>
      <h2 class="lettering">{home.work.heading}</h2>
      {home.work.body.map((p) => <p>{p}</p>)}
      <a class="more" href="/talks">{home.work.talksLink}</a>
    </div>
  </section>

  <AfterHours class="beat" heading={home.lab.heading} say={home.narrator.lab} />

  <section class="projects wrap beat" id="projects" tabindex="-1" data-say={home.narrator.projects}>
    <h2 class="lettering section-head">{home.projects.heading}</h2>
    <div class="project-grid">
      {projects.map((p) => (
        <article class:list={['panel', 'project', p.data.size]}>
          <h3 transition:name={`project-${p.id}`}>
            <a class="project-link" href={`/projects/${p.id}`}>{p.data.title}</a>
          </h3>
          <p>{p.data.blurb}</p>
          <div class="project-foot">
            <span class="year">{p.data.year}</span>
            <span class="project-more">
              {p.journal && <a href={p.journal}>Build journal</a>}
              {p.code && <a href={p.code.href}>GitHub</a>}
            </span>
          </div>
        </article>
      ))}
    </div>
    <a class="more on-field" href="/projects">{home.projects.all}</a>
  </section>

  <section class="log wrap beat" id="log" tabindex="-1" data-say={home.narrator.log}>
    <h2 class="lettering section-head">{home.log.heading}</h2>
    <div class="posts"><PostList posts={posts} showYear /></div>
    <a class="more on-field" href="/log">{home.log.all}</a>
  </section>

  <Palette />
  <Narrator quips={home.quips} />
</Base>

<script>
  // The shot section asks the corner narrator to react through
  // 'narrator:say'. Claim the line (and so suppress the section's own
  // balloon) only when the narrator is on screen.
  const onSay = (e: Event) => {
    const nar = document.querySelector<HTMLElement>('[data-narrator]');
    const line = nar?.querySelector<HTMLElement>('[data-line]');
    if (!nar || !line || !nar.hasAttribute('data-on') || getComputedStyle(nar).display === 'none') return;
    line.textContent = String((e as CustomEvent).detail);
    line.classList.remove('pop');
    void line.offsetWidth;
    line.classList.add('pop');
    e.preventDefault();
  };
  document.addEventListener('astro:page-load', () => window.addEventListener('narrator:say', onSay));
  document.addEventListener('astro:before-swap', () => window.removeEventListener('narrator:say', onSay));
</script>

<style>
  /* Components put their scripts between sections, so spacing hangs off
     a class instead of section + section. */
  :global(.beat) {
    margin-top: clamp(64px, 10vw, 120px);
  }
  .section-head {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 26px;
  }
  .more {
    display: inline-block;
    margin-top: 18px;
    font-weight: 700;
  }
  .more::after {
    content: ' →';
  }
  .on-field {
    color: var(--page);
  }

  .work-panel {
    padding-top: 56px;
  }
  .work-panel h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 18px;
  }
  .work-panel p {
    max-width: var(--measure);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--gutter);
  }
  .project {
    position: relative;
    grid-column: span 3;
    display: flex;
    flex-direction: column;
    min-height: 200px;
  }
  .project.wide {
    grid-column: span 6;
    background: var(--accent);
    min-height: 240px;
  }
  .project h3 {
    font-family: var(--f-letter);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    margin-bottom: 12px;
  }
  .project.wide h3 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
  }
  .project p {
    max-width: 52ch;
  }
  .project-link {
    text-decoration: none;
  }
  /* The title link covers the whole card; the code and journal links
     sit above it. */
  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .project-foot {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .year {
    font-family: var(--f-hand);
    font-size: 1.2rem;
  }
  .project-more {
    position: relative;
    display: flex;
    gap: 16px;
    font-weight: 700;
  }
  .project-more a:hover {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 4px;
  }
  .project.wide .project-more a:hover {
    text-decoration-color: var(--ink);
  }
  .project:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 5px;
  }
  .project.wide:hover h3 {
    text-decoration-color: var(--ink);
  }
  .posts {
    max-width: 820px;
  }

  @media (max-width: 820px) {
    .project,
    .project.wide {
      grid-column: span 6;
    }
  }
</style>
