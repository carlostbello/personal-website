---
// The after-hours section as one comic page that assembles itself while
// it is pinned: the panel slots ink in, the title slams in as strips, each
// panel drops into its slot, its drawing inks, a sound effect bursts out,
// and a splash panel closes the page.
//
// Every element's state is a scroll-driven CSS animation on the track's
// view timeline (`--cp`), with a beat range given by --a/--b. Browsers
// without scroll timelines get the same animations, paused and scrubbed
// by assemble.ts. Without JS, with reduced motion or on narrow screens it
// is a plain static comic page.
import { Image } from 'astro:assets';
import Rack from '../../components/drawings/Rack.astro';
import Espresso from '../../components/drawings/Espresso.astro';
import SignalPath from '../../components/drawings/SignalPath.astro';
import avatar from '../../assets/avatar.png';
import { home } from '../../lib/copy';

const drawings = [Rack, Espresso, SignalPath];
const keys = ['rack', 'shot', 'amp'] as const;
const sfx = ['WHIRRR', 'PSSSHHT', 'TWANG'];

// Beat ranges, as % of the pinned scroll. Each panel: drop, then its
// caption stamps and drawing inks, then the sound effect lands.
const beats = [
  { drop: [16, 23], cap: [23, 26], ink: [23, 32], sfx: [31, 35] },
  { drop: [36, 43], cap: [43, 46], ink: [43, 52], sfx: [51, 55] },
  { drop: [56, 63], cap: [63, 66], ink: [63, 71], sfx: [70, 74] },
];
const range = ([a, b]: number[]) => `--a:${a}%;--b:${b}%`;

// A jagged burst for the sound effects, deterministic so it renders the
// same every build.
const spikes = 18;
const burst = Array.from({ length: spikes * 2 }, (_, i) => {
  const angle = (i / (spikes * 2)) * Math.PI * 2;
  const r = i % 2 ? 0.62 + ((i * 7) % 5) * 0.035 : 1 - ((i * 3) % 4) * 0.06;
  return `${(100 + Math.cos(angle) * 98 * r).toFixed(1)},${(60 + Math.sin(angle) * 58 * r).toFixed(1)}`;
}).join(' ');

const strips = [0, 1, 2, 3];
---
<section class="cp" data-cp data-say={home.narrator.lab} aria-labelledby="cp-title">
  <div class="cp-track">
    <div class="cp-stage">
      <div class="cp-page wrap">
        <div class="cp-cell cp-title">
          <h2 id="cp-title" class="lettering">{home.lab.heading}</h2>
          <span class="cp-strips" aria-hidden="true">
            {strips.map((s) => (
              <span class="cp-strip beat lettering" style={`--s:${s};${range([6 + s * 2.2, 12 + s * 2.2])}`}>
                {home.lab.heading}
              </span>
            ))}
          </span>
        </div>

        {home.lab.panels.map((p, i) => {
          const Drawing = drawings[i];
          const b = beats[i];
          return (
            <div class={`cp-cell cp-${keys[i]}`} data-ink-a={b.ink[0]} data-ink-b={b.ink[1]}>
              <svg class="cp-slot" aria-hidden="true">
                <rect class="beat" pathLength="1" width="100%" height="100%" style={range([2 + i * 2, 8 + i * 2])} />
              </svg>
              <a class="panel cp-panel beat" href={p.href} style={range(b.drop)}>
                <span class="caption beat" style={range(b.cap)}>{p.caption}</span>
                <span class="cp-art"><Drawing /></span>
                <p>{p.line}</p>
              </a>
              <span class="cp-sfx beat" aria-hidden="true" style={range(b.sfx)}>
                <svg viewBox="0 0 200 120" preserveAspectRatio="none"><polygon points={burst} /></svg>
                <span class="lettering">
                  {[...sfx[i]].map((ch, k) => <span style={`--k:${k}`}>{ch}</span>)}
                </span>
              </span>
            </div>
          );
        })}

        <div class="cp-cell cp-splash">
          <svg class="cp-slot" aria-hidden="true">
            <rect class="beat" pathLength="1" width="100%" height="100%" style={range([8, 14])} />
          </svg>
          <div class="panel cp-panel cp-splash-panel beat" style={range([76, 82])}>
            <p class="balloon cp-b1 beat" style={range([87, 90])}>{home.quips[2]}</p>
            <p class="balloon cp-b2 beat" data-tail="left" style={range([92, 95])}>{home.quips[1]}</p>
            <Image
              src={avatar}
              alt="Cartoon of Carlos grinning with his arms crossed"
              width={420}
              height={420}
              class="cp-me beat"
              style={range([80, 87])}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import './assemble';
</script>

<style>
  /* ============ static page (no JS, reduced motion, phones) ============ */
  .cp {
    margin-block: clamp(64px, 10vw, 120px);
  }
  .cp-page {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-areas:
      't t t t t t t t s s s s'
      'r r r r e e e e s s s s'
      'g g g g g g g g s s s s';
    gap: calc(var(--gutter) * 1.4);
  }
  .cp-cell {
    position: relative;
    min-width: 0;
  }
  .cp-title {
    grid-area: t;
    align-self: end;
  }
  .cp-rack {
    grid-area: r;
  }
  .cp-shot {
    grid-area: e;
  }
  .cp-amp {
    grid-area: g;
  }
  .cp-splash {
    grid-area: s;
  }

  .cp-title h2,
  .cp-strip {
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    white-space: nowrap;
  }
  .cp-strips {
    display: none;
  }

  /* The slot: a heavy ink rule the panel lands on. Only visible while
     the page is assembling. */
  .cp-slot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    display: none;
  }
  .cp-slot rect {
    fill: color-mix(in srgb, var(--field-deep) 70%, transparent);
    stroke: var(--ink);
    stroke-width: 5;
    stroke-dasharray: 1;
    vector-effect: non-scaling-stroke;
  }

  .cp-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-top: 52px;
    text-decoration: none;
    transform: rotate(var(--rest, 0deg));
    transition: transform 0.3s var(--pop);
  }
  .cp-rack .cp-panel {
    --rest: -0.9deg;
  }
  .cp-shot .cp-panel {
    --rest: 0.7deg;
  }
  .cp-amp .cp-panel {
    --rest: -0.4deg;
  }
  a.cp-panel:hover {
    transform: rotate(0deg) translateY(-6px);
  }
  .cp-panel p {
    margin: 0;
  }
  .cp-art {
    display: block;
    flex: 1 1 auto;
    min-height: 170px;
    position: relative;
    margin-block: 6px 14px;
  }
  .cp-art :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Sound effects: marigold lettering bursting out of the panel edge. */
  .cp-sfx {
    position: absolute;
    z-index: 3;
    display: grid;
    place-items: center;
    padding: 0.9em 1.3em;
    pointer-events: none;
    transform: rotate(var(--r));
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
  }
  .cp-sfx svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cp-sfx polygon {
    fill: var(--page);
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .cp-sfx .lettering {
    position: relative;
    display: flex;
    -webkit-text-stroke-width: 0.1em;
  }
  .cp-sfx .lettering span {
    display: inline-block;
    transform: translateY(calc(sin(var(--k) * 1.7rad) * 0.08em)) rotate(calc(sin(var(--k) * 2.3rad) * 6deg));
  }
  .cp-rack .cp-sfx {
    --r: -9deg;
    right: -17%;
    bottom: 46%;
    font-size: clamp(1.3rem, 2.1vw, 2rem);
  }
  .cp-shot .cp-sfx {
    --r: 7deg;
    right: -10%;
    top: -9%;
  }
  .cp-amp .cp-sfx {
    --r: -6deg;
    right: 3%;
    top: -16%;
    font-size: clamp(2rem, 3.6vw, 3.4rem);
  }

  /* Splash: the big closing panel. Marigold with a halftone screen. */
  .cp-splash-panel {
    --rest: 0.9deg;
    background-color: var(--accent);
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 18%, transparent) 1.3px, transparent 1.8px);
    background-size: 9px 9px;
    padding: 20px 18px 0;
    justify-content: flex-end;
    align-items: center;
    min-height: 460px;
    overflow: visible;
  }
  .cp-me {
    width: min(100%, 360px);
    height: auto;
    max-height: 62%;
    object-fit: contain;
    object-position: bottom;
    margin-bottom: 0;
  }
  .cp-splash-panel .balloon {
    position: absolute;
    z-index: 2;
    max-width: 78%;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    padding: 14px 24px;
    text-wrap: balance;
  }
  .cp-b1 {
    top: 8%;
    left: 6%;
    transform-origin: 76% 120%;
  }
  .cp-b2 {
    top: 27%;
    right: 4%;
    transform-origin: 24% 120%;
  }

  @media (max-width: 899px) {
    .cp-page {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        't t'
        'r r'
        'e e'
        'g g'
        's s';
      row-gap: calc(var(--gutter) * 2.4);
    }
    .cp-art {
      min-height: 180px;
    }
    .cp-rack .cp-sfx {
      right: -2%;
      top: 22%;
    }
    .cp-shot .cp-sfx {
      right: -2%;
    }
    .cp-splash-panel {
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }

  /* ============ live: the pinned page that assembles ============ */
  @media (min-width: 900px) and (min-height: 600px) and (prefers-reduced-motion: no-preference) {
    .cp[data-live] .cp-track {
      height: 520vh;
      view-timeline: --cp block;
    }
    .cp[data-live] .cp-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      display: grid;
      align-items: center;
      overflow: clip;
    }
    .cp[data-live] .cp-page {
      height: calc(100svh - 56px);
      max-height: 900px;
      grid-template-rows: auto minmax(0, 1fr) minmax(0, 1fr);
    }
    .cp[data-live] .cp-art {
      min-height: 0;
    }
    .cp[data-live] .cp-splash-panel {
      min-height: 0;
      overflow: clip;
      overflow-clip-margin: 4px;
    }
    .cp[data-live] .cp-slot {
      display: block;
    }
    .cp[data-live] .cp-strips {
      display: block;
    }
    /* The real heading stays for screen readers and layout; the strips
       are what you see. */
    .cp[data-live] .cp-title h2 {
      color: transparent;
      -webkit-text-stroke-color: transparent;
    }
    .cp-strip {
      position: absolute;
      left: 0;
      bottom: 0;
    }
    .cp-strip:nth-child(1) {
      clip-path: inset(-30% -5% 75% -5%);
    }
    .cp-strip:nth-child(2) {
      clip-path: inset(25% -5% 50% -5%);
    }
    .cp-strip:nth-child(3) {
      clip-path: inset(50% -5% 25% -5%);
    }
    .cp-strip:nth-child(4) {
      clip-path: inset(75% -5% -30% -5%);
    }

    /* Shared beat plumbing. Range comes from --a/--b on each element. */
    .cp[data-live] .beat {
      animation-duration: 1s;
      animation-timing-function: linear;
      animation-fill-mode: both;
    }
    .cp[data-live] a.cp-panel:hover {
      transform: rotate(var(--rest));
    }
    .cp[data-live] .cp-panel {
      transition: none;
      animation-name: cp-drop;
    }
    .cp[data-live] .cp-slot rect {
      animation-name: cp-rule;
    }
    .cp[data-live] .cp-strip {
      animation-name: cp-strip-l;
    }
    .cp[data-live] .cp-strip:nth-child(even) {
      animation-name: cp-strip-r;
    }
    .cp[data-live] .caption {
      animation-name: cp-stamp;
      transform-origin: 20% 50%;
    }
    .cp[data-live] .cp-sfx {
      animation-name: cp-burst;
    }
    .cp[data-live] .balloon {
      animation-name: cp-pop;
    }
    .cp[data-live] .cp-me {
      animation-name: cp-rise;
      transform-origin: 50% 100%;
    }
    .cp[data-live] :global(.cp-stroke) {
      stroke-dasharray: var(--len);
      transition: none;
      animation-name: cp-ink;
    }

    @supports (animation-timeline: view()) {
      .cp[data-live] .beat,
      .cp[data-live] :global(.cp-stroke) {
        animation-duration: auto;
        animation-timeline: --cp;
        animation-range: contain var(--a, 0%) contain var(--b, 100%);
      }
    }
    @supports not (animation-timeline: view()) {
      .cp[data-live] .beat,
      .cp[data-live] :global(.cp-stroke) {
        animation-play-state: paused;
      }
    }
  }

  /* Panel drop: falls in tilted, overshoots past its slot, bounces back
     and settles at its resting tilt. Gravity in, snap out. */
  @keyframes cp-drop {
    0% {
      transform: translateY(-115vh) rotate(calc(var(--rest) * -9));
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    55% {
      transform: translateY(5%) rotate(calc(var(--rest) * 3));
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1);
    }
    75% {
      transform: translateY(-2.2%) rotate(calc(var(--rest) * -1.5));
      animation-timing-function: ease-in-out;
    }
    88% {
      transform: translateY(0.6%) rotate(calc(var(--rest) * 1.3));
    }
    100% {
      transform: rotate(var(--rest));
    }
  }
  @keyframes cp-rule {
    from {
      stroke-dashoffset: 1;
      fill-opacity: 0;
    }
    70% {
      fill-opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      fill-opacity: 1;
    }
  }
  @keyframes cp-strip-l {
    0% {
      transform: translateX(-120vw) skewX(-18deg);
      animation-timing-function: cubic-bezier(0.3, 0, 0.6, 1);
    }
    70% {
      transform: translateX(1.5%) skewX(4deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes cp-strip-r {
    0% {
      transform: translateX(120vw) skewX(18deg);
      animation-timing-function: cubic-bezier(0.3, 0, 0.6, 1);
    }
    70% {
      transform: translateX(-1.5%) skewX(-4deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes cp-stamp {
    0% {
      transform: scale(1.9) rotate(-8deg);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    65% {
      transform: scale(0.92) rotate(1deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes cp-burst {
    0% {
      transform: rotate(calc(var(--r) - 30deg)) scale(0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    50% {
      transform: rotate(calc(var(--r) + 6deg)) scale(1.3);
    }
    72% {
      transform: rotate(calc(var(--r) - 2deg)) scale(0.9);
    }
    100% {
      transform: rotate(var(--r)) scale(1);
    }
  }
  @keyframes cp-pop {
    0% {
      transform: scale(0.1);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    65% {
      transform: scale(1.1);
    }
    100% {
      transform: scale(1);
    }
  }
  @keyframes cp-rise {
    0% {
      transform: translateY(105%);
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    70% {
      transform: translateY(-5%) rotate(-1.5deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes cp-ink {
    from {
      stroke-dashoffset: var(--len);
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
