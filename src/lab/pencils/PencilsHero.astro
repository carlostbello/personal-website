---
// The homepage hero, drawn in production passes on first visit:
// pencils, inks, colors. Finishes on the exact homepage hero. Afterwards
// the caption tag flips between passes, and a hover lens shows the
// pencils under the avatar. No JS / reduced motion / seen this session:
// the plain finished hero.
//
// Leaves nothing below its ink floor: whatever comes next on the page
// (e.g. a nav strip) sits directly under the border.
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.png';
import { home } from '../../lib/copy';

interface Props {
  /** Line under the name. */
  role?: string;
  /** Speech balloon text. */
  hello?: string;
  /** Lettered name; each space-separated word goes on its own line. */
  name?: string;
  /** Hand-lettered hint shown after the intro on fine pointers. */
  hint?: string;
  /** Avatar alt text. */
  alt?: string;
  class?: string;
}

const {
  role = home.role,
  hello = home.hello,
  name = 'Carlos Bello',
  hint = 'Hover over me to see the pencils.',
  alt = 'Cartoon of Carlos grinning with his arms crossed',
  class: className,
} = Astro.props;

const words = name.split(/\s+/).filter(Boolean);
const passes = ['Pencils', 'Inks', 'Colors'];

// Construction lines over the avatar, in the PNG's own 834px space.
const construct = [
  'M455 330m-188 0a188 188 0 1 0 376 0a188 188 0 1 0 -376 0',
  'M470 118 Q492 330 462 560',
  'M262 372 L652 346',
  'M360 446 L612 430',
  'M362 470 L340 580 M512 488 L526 572',
  'M60 834 Q110 590 336 556 L540 552 Q720 566 790 834',
  'M110 806 Q430 742 752 800',
  'M300 392 a34 40 0 1 0 1 0',
];
---
<section class:list={['hero', 'wrap', className]} data-hero data-pencils-hero>
  <div class="board" aria-hidden="true">
    <span class="flood"></span>
    <span class="crop tl"></span><span class="crop tr"></span><span class="crop bl"></span><span class="crop br"></span>
  </div>

  <div class="tag" data-pencils-tag hidden>
    <div class="tag-intro">
      <span class="tag-now" data-pencils-now aria-live="polite">Pencils — 1 of 3</span>
      <button type="button" class="tag-skip" data-pencils-skip>Skip</button>
    </div>
    <div class="tag-controls" role="group" aria-label="Show a production pass">
      {passes.map((p) => <button type="button" data-pencils-pass aria-pressed="false">{p}</button>)}
    </div>
  </div>

  <p class="hint" data-pencils-hint hidden>{hint}</p>

  <h1 class="lettering name">
    {words.map((w) => (
      <span class="word">
        <span class="w-pencil" data-t={w} aria-hidden="true">{w}</span>
        <span class="w-ink">{w}</span>
      </span>
    ))}
  </h1>
  <p class="role">{role}</p>
  <div class="who" data-lean>
    <p class="balloon hello">{hello}</p>
    <div class="art">
      <Image src={avatar} alt={alt} width={420} height={420} loading="eager" class="me" />
      <canvas class="passes" data-src={avatar.src} aria-hidden="true"></canvas>
      <svg class="construct" viewBox="0 0 834 834" aria-hidden="true">
        {construct.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
      </svg>
    </div>
  </div>
  <span class="floor" aria-hidden="true"></span>
  <script is:inline>
    // Hold the hero on a blank board before first paint if the intro will play.
    (function () {
      var h = document.currentScript && document.currentScript.parentElement;
      if (!h || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      try {
        if (sessionStorage.getItem('lab-pencils-seen') === '1') return;
      } catch (e) {}
      h.setAttribute('data-pencils-intro', 'play');
      h.setAttribute('data-pencils-stage', '0');
      // Failsafe: if the script never arrives, show the finished hero.
      setTimeout(function () {
        if (h.getAttribute('data-pencils-stage') === '0') {
          h.removeAttribute('data-pencils-stage');
          h.removeAttribute('data-pencils-intro');
        }
      }, 3000);
    })();
  </script>
</section>

<script>
  import './intro';
</script>

<style>
  /* ---------- the finished hero (identical to the homepage's) ---------- */
  .hero {
    /* Non-photo blue, mixed from the field token. */
    --pencils-blue: color-mix(in srgb, var(--field) 52%, var(--page));
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 400px);
    grid-template-rows: 1fr auto;
    align-items: end;
    min-height: min(72vh, 660px);
    padding-top: 24px;
    border-bottom: var(--line) solid var(--ink);
  }
  .name {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    font-size: clamp(4rem, 11.5vw, 10rem);
  }
  .word {
    position: relative;
    display: block;
  }
  .word:nth-child(2) {
    padding-left: 0.4em;
  }
  .w-pencil,
  .construct,
  .floor,
  .board {
    display: none;
  }
  .role {
    grid-column: 1;
    grid-row: 2;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 28px;
  }
  .who {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    transform: rotate(var(--lean, 0deg)) translateY(var(--shift, 0));
    transform-origin: 50% 100%;
    transition: transform 0.4s var(--snap);
  }
  .art {
    position: relative;
    margin-bottom: -2px; /* sit on the hero's ink floor */
  }
  .me {
    display: block;
    width: 100%;
    height: auto;
  }
  .passes {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* WebGL draws the passes; once he's finished and the lens is off, the
     real image takes over again so the end frame is pixel-identical. */
  .gl .passes {
    display: block;
  }
  .gl:not(.pencils-art) .me {
    opacity: 0;
  }
  .gl.pencils-art .passes {
    visibility: hidden;
  }
  .hello {
    position: absolute;
    left: -34%;
    top: 12%;
    max-width: 250px;
    z-index: 2;
    transform-origin: 80% 100%;
  }
  .hint {
    position: absolute;
    left: 6px;
    top: 52px;
    margin: 0;
    font-family: var(--f-hand);
    font-size: 1.05rem;
    color: var(--page);
  }

  /* Without the intro (no JS, reduced motion, seen this session): the homepage's own entrance. */
  .hero:not([data-pencils-intro='play'], [data-pencils-intro='played']) .word {
    animation: pencils-stamp 0.5s var(--pop) both;
  }
  .hero:not([data-pencils-intro='play'], [data-pencils-intro='played']) .word:nth-child(2) {
    animation-delay: 0.12s;
  }
  .hero:not([data-pencils-intro='play'], [data-pencils-intro='played']) .role {
    animation: pencils-rise 0.5s var(--snap) 0.35s both;
  }
  .hero:not([data-pencils-intro='play'], [data-pencils-intro='played']) .art {
    animation: pencils-rise 0.7s var(--pop) 0.2s both;
  }
  .hero:not([data-pencils-intro='play'], [data-pencils-intro='played']) .hello {
    animation: pencils-pop 0.4s var(--pop) 0.75s both;
  }
  @keyframes pencils-stamp {
    from {
      transform: scale(1.35) rotate(-4deg);
      opacity: 0;
    }
  }
  @keyframes pencils-rise {
    from {
      transform: translateY(40%);
      opacity: 0;
    }
  }
  @keyframes pencils-pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  /* ---------- the tag: caption box during the intro, pass switcher after ---------- */
  .tag {
    position: absolute;
    top: 8px;
    left: 0;
    z-index: 5;
    background: var(--accent);
    color: var(--ink);
    border: var(--line) solid var(--ink);
    font-family: var(--f-hand);
    font-size: 1.1rem;
    line-height: 1.1;
    transform: rotate(-1.2deg);
  }
  .tag[hidden] {
    display: none;
  }
  .tag-intro,
  .tag-controls {
    display: flex;
    align-items: stretch;
  }
  .tag[data-mode='intro'] .tag-controls,
  .tag[data-mode='controls'] .tag-intro {
    display: none;
  }
  .tag-now {
    padding: 6px 12px 5px;
    min-width: 9.5em;
  }
  .tag-now.pop {
    animation: pencils-pop 0.3s var(--pop);
  }
  .tag button {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 0;
    border-left: var(--line) solid var(--ink);
    padding: 6px 12px 5px;
    cursor: pointer;
  }
  .tag-controls button:first-child {
    border-left: 0;
  }
  .tag button:hover {
    background: var(--page);
  }
  .tag button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--accent);
  }
  .tag button:focus-visible {
    outline-offset: -6px;
    outline-color: var(--ink);
  }
  .tag button[aria-pressed='true']:focus-visible {
    outline-color: var(--accent);
  }

  /* ---------- production stages (0 blank, 1 pencils, 2 inks, 3 colors = finished) ---------- */
  .hero[data-pencils-stage] {
    border-bottom-color: transparent;
  }
  .hero[data-pencils-stage] :is(.w-pencil, .construct, .floor, .board) {
    display: block;
  }

  /* the board: a sheet of bristol on the blue desk, flooded blue at colors */
  .board {
    position: absolute;
    inset: 0 -14px 0;
    z-index: -2;
    background: var(--page);
    transition: opacity 0.4s;
  }
  .flood {
    position: absolute;
    inset: 0;
    background: var(--field);
    clip-path: circle(0% at 74% 56%);
    transition: clip-path 0.85s var(--snap);
  }
  .crop {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 0 solid var(--pencils-blue);
    transition: opacity 0.4s;
  }
  .crop.tl {
    top: 8px;
    left: 8px;
    border-width: 2px 0 0 2px;
  }
  .crop.tr {
    top: 8px;
    right: 8px;
    border-width: 2px 2px 0 0;
  }
  .crop.bl {
    bottom: 8px;
    left: 8px;
    border-width: 0 0 2px 2px;
  }
  .crop.br {
    bottom: 8px;
    right: 8px;
    border-width: 0 2px 2px 0;
  }
  .hero[data-pencils-stage='3'] .flood {
    clip-path: circle(150% at 74% 56%);
  }
  .hero[data-pencils-stage='3'] .crop {
    opacity: 0;
  }
  /* once the flood has covered it, the sheet goes away entirely */
  .hero[data-pencils-stage='3'] .board {
    opacity: 0;
    transition-delay: 0.85s;
  }

  /* lettering: guides and blue roughs, then the pen, then the marigold flat */
  .w-pencil {
    position: absolute;
    inset: 0;
    z-index: -1;
    padding-left: inherit;
    color: transparent;
    -webkit-text-stroke: 2px var(--pencils-blue);
    clip-path: inset(-0.2em calc(100% + 0.2em) -0.2em -0.2em);
    transition:
      clip-path 1.1s cubic-bezier(0.5, 0, 0.3, 1),
      opacity 0.5s;
  }
  .w-pencil::after {
    content: attr(data-t);
    position: absolute;
    inset: 0;
    padding-left: inherit;
    transform: translate(0.025em, -0.02em) rotate(-0.5deg);
    opacity: 0.7;
  }
  .word:nth-child(2) .w-pencil {
    transition-delay: 0.25s, 0s;
  }
  .hero[data-pencils-stage] .word::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: -8px;
    right: 0;
    top: 0.08em;
    bottom: 0.1em;
    border-block: 1.5px solid var(--pencils-blue);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition:
      transform 0.8s var(--snap),
      opacity 0.5s;
  }
  .hero[data-pencils-stage] .w-ink {
    clip-path: inset(-0.4em calc(100% + 0.4em) -0.4em -0.4em);
    color: var(--page);
    transition:
      clip-path 0.9s cubic-bezier(0.6, 0, 0.4, 1),
      color 0.45s;
  }
  .hero[data-pencils-stage] .word:nth-child(2) .w-ink {
    transition-delay: 0.2s, 0s;
  }
  .hero:not([data-pencils-stage='0']) .w-pencil {
    clip-path: inset(-0.2em -0.2em -0.2em -0.2em);
  }
  .hero:not([data-pencils-stage='0']) .word::before {
    transform: none;
  }
  .hero:is([data-pencils-stage='2'], [data-pencils-stage='3']) .w-ink {
    clip-path: inset(-0.4em -0.4em -0.4em -0.4em);
  }
  .hero[data-pencils-stage='3'] .w-ink {
    color: var(--accent);
  }
  .hero[data-pencils-stage='3'] .w-pencil,
  .hero[data-pencils-stage='3'] .word::before {
    opacity: 0;
  }

  /* role line and balloon */
  .hero[data-pencils-stage] .role {
    transition:
      color 0.5s,
      opacity 0.4s;
  }
  .hero[data-pencils-stage='0'] .role,
  .hero[data-pencils-stage='0'] .hello {
    opacity: 0;
  }
  .hero[data-pencils-stage='1'] .role {
    color: var(--pencils-blue);
  }
  .hero[data-pencils-stage='2'] .role {
    color: var(--ink);
  }
  .hero[data-pencils-stage] .hello {
    transition:
      color 0.5s,
      background-color 0.5s,
      opacity 0.4s;
  }
  .hero[data-pencils-stage] .hello::before {
    transition: border-color 0.5s;
  }
  .hero[data-pencils-stage='1'] .hello {
    color: var(--pencils-blue);
    background-color: transparent;
  }
  .hero[data-pencils-stage='1'] .hello::before {
    border-color: var(--pencils-blue);
    border-width: 2px;
  }
  .hero[data-pencils-stage='1'] .hello::after {
    filter: drop-shadow(2px 0 0 var(--pencils-blue)) drop-shadow(-2px 0 0 var(--pencils-blue))
      drop-shadow(0 2px 0 var(--pencils-blue));
  }

  /* construction lines on the avatar */
  .construct {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--pencils-blue);
    stroke-width: 3;
    stroke-linecap: round;
    transition: opacity 0.5s;
  }
  .construct path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.7s cubic-bezier(0.5, 0, 0.3, 1) calc(var(--i) * 70ms);
  }
  .hero:not([data-pencils-stage='0']) .construct path {
    stroke-dashoffset: 0;
  }
  .hero[data-pencils-stage='3'] .construct {
    opacity: 0;
  }
  /* No WebGL: the art itself waits for the inks. */
  .hero:is([data-pencils-stage='0'], [data-pencils-stage='1']) .who:not(.gl) .me {
    opacity: 0;
  }
  .who:not(.gl) .me {
    transition: opacity 0.6s;
  }

  /* the floor: a ruled pencil line, then the inked one (stands in for the border) */
  .floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * var(--line));
    height: var(--line);
  }
  .floor::before,
  .floor::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .floor::before {
    left: -10px;
    right: -10px;
    height: 2px;
    top: 1px;
    background: var(--pencils-blue);
    transform: scaleX(0) rotate(-0.15deg);
    transform-origin: 0 50%;
    transition:
      transform 0.9s var(--snap),
      opacity 0.5s;
  }
  .floor::after {
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.9s cubic-bezier(0.6, 0, 0.4, 1);
  }
  .hero:not([data-pencils-stage='0']) .floor::before {
    transform: rotate(-0.15deg);
  }
  .hero:is([data-pencils-stage='2'], [data-pencils-stage='3']) .floor::after {
    transform: none;
  }
  .hero[data-pencils-stage='3'] .floor::before {
    opacity: 0;
  }

  /* ---------- small screens ---------- */
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      min-height: 0;
    }
    /* make room for the tag above the name */
    .hero:has(.tag:not([hidden])) {
      padding-top: 64px;
    }
    .name,
    .role,
    .who {
      grid-column: 1;
      grid-row: auto;
    }
    .role {
      font-size: 1.1rem;
      margin-bottom: 8px;
    }
    .who {
      width: min(300px, 70%);
      justify-self: end;
      margin-top: 40px;
    }
    .hello {
      left: -32%;
      top: -10%;
      max-width: 190px;
      font-size: 1.05rem;
      padding: 14px 22px;
    }
    .board {
      inset: 0 -8px 0;
    }
    .hint {
      display: none;
    }
    .tag {
      font-size: 1rem;
    }
    .tag button,
    .tag-now {
      padding-inline: 9px;
    }
  }
</style>
