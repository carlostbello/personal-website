---
/*
  WorkSection: the "By day" section. A panel with the copy, then the day-job
  diagram printed on a WebGL sheet of paper that unfolds as it scrolls in.
  Packets ride the loop inside the network; the ones that try to leave hit
  the air gap with a THUNK. Without JS, without WebGL or with reduced motion
  the same diagram stays as an inked SVG.

  Every visible string is a prop, so the copy can be rewritten freely:

  - caption     Caption box in the panel corner.            default home.work.caption
  - heading     Section heading (lettering).                default home.work.heading
  - body        Paragraphs, one string each.                default home.work.body
  - link        { label, href } under the body, or null.   default { home.work.talksLink, '/talks' }
  - sendLabel   Text on the button that fires a packet.     default 'Try to send one out'
  - labels      Words drawn on the diagram (canvas + SVG fallback). Any subset of:
                  boundary  'the network that stays offline'
                  docs      'your docs'
                  index     'index'
                  model     'model'
                  servers   'servers'
                  internet  'the internet'
                  gap       'AIR GAP'
                  thunk     'THUNK!'      (burst word, alternates with blocked)
                  blocked   'BLOCKED!'
                Long strings shrink to fit their spot rather than overflow.
  - diagramAlt  Accessible description of the diagram.
  - say         data-say line for the corner Narrator (optional).
  - id, class   Passed to the root <section> (it also carries .wrap).

  Usage:
    import WorkSection from '../../lab/air-gap/WorkSection.astro';
    <WorkSection say={home.narrator.work} />
*/
import { home } from '../../lib/copy';
import { defaultLabels, type Labels } from './diagram';

interface Props {
  caption?: string;
  heading?: string;
  body?: string[];
  link?: { label: string; href: string } | null;
  sendLabel?: string;
  labels?: Partial<Labels>;
  diagramAlt?: string;
  say?: string;
  id?: string;
  class?: string;
}

const {
  caption = home.work.caption,
  heading = home.work.heading,
  body = home.work.body,
  link = { label: home.work.talksLink, href: '/talks' },
  sendLabel = 'Try to send one out',
  labels: labelProps = {},
  diagramAlt = 'Documents, an index, a model and servers inside a closed network. Packets that try to reach the internet bounce off the air gap.',
  say,
  id,
  class: className,
} = Astro.props;

const labels: Labels = { ...defaultLabels, ...labelProps };
---
<section class:list={['ag-work', 'wrap', className]} id={id} data-say={say}>
  <div class="panel ag-panel">
    <span class="caption">{caption}</span>
    <h2 class="lettering">{heading}</h2>
    <div class="ag-text">
      {body.map((p) => <p>{p}</p>)}
      {link && <a class="ag-more" href={link.href}>{link.label}</a>}
    </div>
  </div>
  <div class="ag-sheet-wrap">
    <div class="ag-sheet" data-ag-sheet data-ag-labels={JSON.stringify(labels)} data-ag-alt={diagramAlt}>
      <div class="ag-fallback panel">
        <svg viewBox="0 0 560 230" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" data-ink role="img" aria-label={diagramAlt}>
          <path d="M40 92c-18 0-26-22-8-30 0-22 30-28 40-12 12-16 42-10 40 12 18 4 14 30-4 30z" />
          <path d="M34 50 112 102M112 50 34 102" stroke="var(--accent)" stroke-width="5" />
          <path d="M150 20v190M168 20v190" stroke-dasharray="10 9" />
          <rect x="196" y="20" width="350" height="190" rx="6" />
          <rect x="216" y="62" width="70" height="86" />
          <path d="M228 82h46M228 96h46M228 110h34M228 124h40" />
          <path d="M290 105h34" />
          <path d="M316 97l10 8-10 8" />
          <circle cx="366" cy="105" r="34" />
          <path d="M350 98h32M350 112h22" />
          <path d="M402 105h34" />
          <path d="M428 97l10 8-10 8" />
          <rect x="444" y="70" width="86" height="70" rx="30" />
          <g fill="var(--ink)" stroke="none" font-family="Patrick Hand" font-size="17">
            <text x="74" y="132" text-anchor="middle">{labels.internet}</text>
            <text x="251" y="170" text-anchor="middle">{labels.docs}</text>
            <text x="366" y="160" text-anchor="middle">{labels.index}</text>
            <text x="487" y="166" text-anchor="middle">{labels.model}</text>
            <text x="210" y="44">{labels.boundary}</text>
          </g>
          <text x="159" y="115" transform="rotate(-90 159 115)" text-anchor="middle" dominant-baseline="middle" font-family="Bowlby One" font-size="13" fill="var(--accent)" stroke="var(--ink)" stroke-width="3" paint-order="stroke">{labels.gap}</text>
        </svg>
      </div>
      <canvas aria-hidden="true"></canvas>
    </div>
    <button type="button" class="ag-send" data-ag-send hidden>{sendLabel}</button>
  </div>
</section>

<script>
  // The sheet (and three.js with it) only loads once it is near the screen,
  // and never under reduced motion: then the inked drawing stays.
  let cleanups: Array<() => void> = [];
  let alive = 0;

  document.addEventListener('astro:page-load', () => {
    const sheets = document.querySelectorAll<HTMLElement>('[data-ag-sheet]');
    if (!sheets.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const ticket = ++alive;
    sheets.forEach((el) => {
      const io = new IntersectionObserver(
        async ([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          try {
            const { mountAirGap } = await import('./scene');
            if (ticket !== alive) return;
            const done = await mountAirGap(el);
            if (ticket === alive) cleanups.push(done);
            else done();
          } catch {
            el.classList.add('ag-no-gl');
          }
        },
        { rootMargin: '400px 0px' },
      );
      io.observe(el);
      cleanups.push(() => io.disconnect());
    });
  });

  document.addEventListener('astro:before-swap', () => {
    alive++;
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });
</script>

<style>
  /* ---------- the copy in a panel ---------- */
  .ag-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(16px, 4vw, 48px);
    align-items: start;
    padding-top: 56px;
    max-width: 980px;
  }
  .ag-panel h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .ag-text p:last-of-type {
    margin-bottom: 0;
  }
  .ag-more {
    display: inline-block;
    margin-top: 18px;
    font-weight: 700;
  }
  .ag-more::after {
    content: ' →';
  }

  /* ---------- the diagram on a sheet ---------- */
  .ag-sheet-wrap {
    margin-top: clamp(20px, 3vw, 32px);
  }
  .ag-sheet {
    position: relative;
  }
  .ag-sheet canvas {
    display: none;
  }
  /* With JS and motion, reserve the sheet's box up front so nothing jumps
     when the paper takes over from the drawing. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ag-sheet:not(.ag-no-gl) {
      aspect-ratio: 1200 / 560;
    }
    :global(.js) .ag-sheet:not(.ag-no-gl) .ag-fallback {
      height: 100%;
      display: grid;
      place-items: center;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 640px) {
    :global(.js) .ag-sheet:not(.ag-no-gl) {
      aspect-ratio: 600 / 1040;
    }
  }
  .ag-sheet.ag-live .ag-fallback,
  :global(.js) .ag-sheet.ag-live .ag-fallback {
    display: none;
  }
  .ag-sheet.ag-live canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    touch-action: pan-y;
  }
  .ag-fallback svg {
    width: 100%;
  }
  .ag-send {
    display: block;
    margin: 14px 0 0;
    font-family: var(--f-hand);
    font-size: 1.2rem;
    line-height: 1.1;
    color: var(--ink);
    background: var(--accent);
    border: var(--line) solid var(--ink);
    padding: 7px 16px 6px;
    cursor: pointer;
    transition: transform 0.15s var(--pop);
  }
  .ag-send:hover {
    transform: rotate(-2deg);
  }
  .ag-send:active {
    transform: scale(0.94);
  }
  .ag-send[hidden] {
    display: none;
  }

  @media (max-width: 820px) {
    .ag-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
