---
// "The homelab": a full-width panel with Carlos's real homelab printed in
// halftone (three.js, loaded when it scrolls near). Drag to turn it, poke a
// machine for its caption. Without WebGL or JS the ink Rack drawing stays.
import Rack from '../../components/drawings/Rack.astro';
import type { DeviceKey } from './scene';

interface Props {
  caption?: string;
  line?: string;
  href?: string;
  linkText?: string;
  hint?: string;
  sfx?: string;
  /** Override any machine's hover caption. */
  labels?: Partial<Record<DeviceKey, string>>;
  /** Passed through as data-say for the Narrator. */
  say?: string;
  /** Wrap in the site's .wrap column (default true). */
  wrap?: boolean;
  class?: string;
}

const {
  caption = 'The homelab',
  line = 'A 10-inch rack handles routing, switching, and Wi-Fi. Next to it: a tower for VMs and storage, and a Mac Studio for local models and daily dev.',
  href = '/projects/homelab',
  linkText = 'More on the homelab',
  hint = 'Drag it around. Poke a machine.',
  sfx = 'Hmmm',
  labels = {},
  say,
  wrap = true,
  class: className,
} = Astro.props;
---
<section class:list={['ink-rack', { wrap }, className]} data-say={say}>
  <figure class="panel ink-rack__panel" data-ink-rack data-ink-rack-labels={JSON.stringify(labels)}>
    <span class="caption">{caption}</span>
    <div class="ink-rack__stage" data-ink-rack-stage>
      <div class="ink-rack__fallback"><Rack /></div>
      <div class="ink-rack__hits" data-ink-rack-hits></div>
      <p class="ink-rack__callout" data-ink-rack-callout hidden aria-live="polite"></p>
      <span class="ink-rack__sfx" aria-hidden="true">{sfx}</span>
    </div>
    <figcaption class="ink-rack__foot">
      <p class="ink-rack__line">{line}</p>
      <span class="ink-rack__hint">{hint}</span>
      <a class="ink-rack__more" href={href}>{linkText}</a>
    </figcaption>
  </figure>
</section>

<script>
  // three.js only loads once a rack panel is near the screen.
  type Mounted = { io: IntersectionObserver; cleanup: (() => void) | null };
  let mounted: Mounted[] = [];
  let ticket = 0;

  const teardown = () => {
    ticket++;
    for (const m of mounted) {
      m.io.disconnect();
      m.cleanup?.();
    }
    mounted = [];
  };

  document.addEventListener('astro:page-load', () => {
    teardown();
    const mine = ticket;
    document.querySelectorAll<HTMLElement>('[data-ink-rack]').forEach((el) => {
      const m: Mounted = { io: null!, cleanup: null };
      m.io = new IntersectionObserver(
        async ([e]) => {
          if (!e.isIntersecting) return;
          m.io.disconnect();
          const { mountRack } = await import('./rack');
          if (mine === ticket) m.cleanup = mountRack(el);
        },
        { rootMargin: '300px' },
      );
      m.io.observe(el);
      mounted.push(m);
    });
  });

  document.addEventListener('astro:before-swap', teardown);
</script>

<style>
  .ink-rack__panel {
    margin: 0;
    padding: 0;
  }
  /* Keep the boiling border above the canvas. */
  .ink-rack__panel::before {
    z-index: 4;
  }
  .ink-rack__panel > .caption {
    z-index: 5;
  }
  .ink-rack__stage {
    position: relative;
    height: clamp(400px, 62vh, 600px);
    overflow: hidden;
    touch-action: pan-y;
  }
  .ink-rack__stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .ink-rack__fallback {
    position: absolute;
    inset: 12% 10% 6%;
    display: grid;
    place-items: center;
  }
  .ink-rack__fallback :global(svg) {
    width: 100%;
    height: 100%;
  }
  .ink-rack__panel:global(.ink-rack--live) .ink-rack__fallback {
    display: none;
  }
  .ink-rack__hits {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ink-rack__hits :global(.ink-rack-hit) {
    position: absolute;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    color: transparent;
    font-size: 1px;
    overflow: hidden;
    pointer-events: none;
  }
  .ink-rack__hits :global(.ink-rack-hit:focus-visible) {
    outline: 4px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 9px var(--ink);
  }
  .ink-rack__callout {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    margin: 0;
    max-width: min(320px, calc(100% - 16px));
    background: var(--accent);
    color: var(--ink);
    border: var(--line) solid var(--ink);
    font-family: var(--f-hand);
    font-size: 1.3rem;
    line-height: 1.1;
    padding: 6px 12px 5px;
    pointer-events: none;
    text-wrap: balance;
  }
  /* Tail: an ink wedge with a marigold wedge inside it. */
  .ink-rack__callout::before,
  .ink-rack__callout::after {
    content: '';
    position: absolute;
    left: var(--ink-rack-tail, 26%);
    width: 22px;
    height: 16px;
    clip-path: polygon(0 0, 100% 0, 15% 100%);
  }
  .ink-rack__callout::before {
    bottom: -17px;
    background: var(--ink);
  }
  .ink-rack__callout::after {
    bottom: -11px;
    left: calc(var(--ink-rack-tail, 26%) + 4px);
    width: 14px;
    height: 10px;
    background: var(--accent);
  }
  .ink-rack__callout[data-below='yes']::before,
  .ink-rack__callout[data-below='yes']::after {
    clip-path: polygon(15% 0, 100% 100%, 0 100%);
  }
  .ink-rack__callout[data-below='yes']::before {
    bottom: auto;
    top: -17px;
  }
  .ink-rack__callout[data-below='yes']::after {
    bottom: auto;
    top: -11px;
  }
  .ink-rack__callout:global(.ink-rack-pop) {
    animation: ink-rack-pop 0.3s var(--pop);
    transform-origin: 30% 100%;
  }
  .ink-rack__callout[hidden] {
    display: none;
  }
  @keyframes ink-rack-pop {
    from {
      scale: 0.4;
      opacity: 0;
    }
  }
  .ink-rack__sfx {
    position: absolute;
    right: 16px;
    top: 14px;
    font-family: var(--f-letter);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1;
    color: var(--accent);
    -webkit-text-stroke: 0.08em var(--ink);
    paint-order: stroke fill;
    transform: rotate(8deg);
    pointer-events: none;
  }
  .ink-rack__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px 24px;
    padding: 14px clamp(18px, 3vw, 32px) 16px;
    border-top: var(--line) solid var(--ink);
  }
  .ink-rack__line {
    grid-row: span 2;
    margin: 0;
    max-width: 62ch;
  }
  .ink-rack__hint {
    display: none;
    font-family: var(--f-hand);
    font-size: 1.2rem;
    justify-self: end;
  }
  .ink-rack__panel:global(.ink-rack--live) .ink-rack__hint {
    display: inline;
  }
  .ink-rack__more {
    font-weight: 700;
    justify-self: end;
    grid-column: 2;
  }
  .ink-rack__more::after {
    content: ' →';
  }

  @media (max-width: 820px) {
    .ink-rack__stage {
      height: clamp(260px, 72vw, 440px);
    }
    .ink-rack__foot {
      grid-template-columns: 1fr;
    }
    .ink-rack__line {
      grid-row: auto;
    }
    .ink-rack__hint,
    .ink-rack__more {
      justify-self: start;
      grid-column: 1;
    }
    .ink-rack__sfx {
      font-size: 1.4rem;
      right: 10px;
      top: 10px;
    }
  }
</style>
