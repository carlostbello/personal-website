---
// "Pull a shot": Carlos's Gaggia Classic (modded with a Gaggiuino) as a
// toy. Hold the button, the brew switch flips, the pump buzzes, the
// Gaggiuino screen and the big chart ink the pressure curve, the cup fills.
// Self-contained section: drop it anywhere. Without JS it renders as one
// frozen frame mid-shot.
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.png';
import { P_MAX, S_MAX, WINDOW, PHASES, idealShot } from './profile';
import { CHART, CUP_BOTTOM, MACHINE, MINI, areaPath, cx, cy, linePath, miniPath, mx, my, streamPath } from './geom';

interface Props {
  /** Extra classes for the <section>, e.g. "wrap". */
  class?: string;
  /** Caption box in the panel corner. */
  caption?: string;
  heading?: string;
  /** Intro line under the heading. */
  line?: string;
  /** Small honest note under the chart. */
  note?: string;
  href?: string;
  linkText?: string;
  /** Line for the corner narrator when this section is in view (data-say). */
  say?: string;
}

const {
  class: className,
  caption = 'The espresso rig',
  heading = 'Pull a shot',
  line = 'My Gaggia Classic, modded with a Gaggiuino. Hold the button to run the pump, watch the pressure climb, and let go when the curve reaches the yellow band.',
  note = 'Demo curve. Real shot logs from the Gaggiuino go here.',
  href = '/projects/espresso-rig',
  linkText = 'How the rig works',
  say,
} = Astro.props;

const ideal = idealShot().pts;
const tip = ideal[ideal.length - 1];
const idealLine = linePath(ideal);
const idealArea = areaPath(ideal);
const idealMini = miniPath(ideal);
const frozenBar = tip[1];

// Chart grid: a dot every 2 s and every bar.
const gx = (CHART.x1 - CHART.x0) / (S_MAX / 2);
const gy = (CHART.y1 - CHART.y0) / P_MAX;
const yTicks = [0, 3, 6, 9, 12];
const xTicks = [0, 10, 20, 30, 40];
const band = { x: cx(WINDOW[0]), w: cx(WINDOW[1]) - cx(WINDOW[0]) };
const phases = PHASES.map((p) => ({ ...p, x0: cx(p.from) + 4, x1: cx(p.to) - 4, mid: (cx(p.from) + cx(p.to)) / 2 }));

// Cup: the frozen frame shows it most of the way full.
const frozenFill = 40;
const frozenTop = CUP_BOTTOM - frozenFill;
const cup = 'M162 350H238L232 410C230 420 170 420 168 410Z';
---
<section class:list={['pas-section', className]} data-say={say}>
  <div class="panel pas-rig" data-pas-root>
    <span class="caption">{caption}</span>

    <div class="pas-machine-col">
      <div class="pas-machine-wrap" data-pas-machine>
        <svg class="pas-machine" viewBox={`${MACHINE.x} ${MACHINE.y} ${MACHINE.w} ${MACHINE.h}`} fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" data-ink role="img" aria-labelledby="pas-machine-title">
          <title id="pas-machine-title">Drawing of a Gaggia Classic espresso machine with a small Gaggiuino touchscreen on its front panel.</title>
          <defs>
            <pattern id="pas-bay" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
              <circle cx="4.5" cy="4.5" r="1.6" fill="var(--field)" stroke="none" />
            </pattern>
            <clipPath id="pas-cup-clip">
              <path d={cup} />
            </clipPath>
          </defs>

          <g class="boil">
            <!-- body: tall brushed-steel box, a little narrower at the top -->
            <path d="M80 44H320C326 44 328 47 328 52L342 442C342 448 338 452 332 452H68C62 452 58 448 58 442L72 52C72 47 74 44 80 44Z" fill="var(--page)" />
            <path d="M84 62 82 186M93 70 92 150M316 62 318 186M307 70 308 150M80 226 77 410M90 240 88 340M320 226 323 410M310 240 312 340" stroke-width="1.6" />
            <path d="M76 452V463H104V452M296 452V463H324V452" />

            <!-- top: cup-warmer tray at the back, water tank lid at the front -->
            <path d="M90 20H310L326 44H74Z" fill="var(--page)" />
            <path d="M84 33H316" stroke-width="2" />
            <path d="M104 27H296" stroke-width="2.5" stroke-dasharray="12 6" />
            <path d="M184 44C186 38 214 38 216 44" stroke-width="2.5" />
            <path d="M118 26 121 10H143L146 26" fill="var(--page)" />
            <path d="M143 14C150 14 150 22 144 22" stroke-width="2.5" />

            <!-- steam knob, top right -->
            <path d="M329 75H341" stroke-width="6" />
            <rect x="340" y="60" width="20" height="30" rx="5" fill="var(--ink)" />
            <path d="M346 65V85M353 65V85" stroke="var(--page)" stroke-width="2" />

            <!-- front panel / brew bay split -->
            <path d="M71 200H329" />
            <path d="M112 200H288V420H112Z" fill="url(#pas-bay)" />

            <!-- Gaggiuino screen bezel -->
            <rect x="122" y="60" width="156" height="82" rx="7" fill="var(--ink)" />
            <rect x="130" y="67" width="140" height="68" rx="2" fill="var(--page)" stroke-width="2" />

            <!-- rocker housings: power, brew, steam -->
            <rect x="135" y="160" width="30" height="24" rx="3" fill="var(--page)" />
            <rect x="185" y="160" width="30" height="24" rx="3" fill="var(--page)" />
            <rect x="235" y="160" width="30" height="24" rx="3" fill="var(--page)" />

            <!-- steam wand, right side, with its rubber grip -->
            <path d="M334 214C356 214 362 222 362 244V330" stroke-width="6" />
            <circle cx="334" cy="214" r="6" fill="var(--page)" />
            <path d="M355 330H369L367 384C367 389 357 389 357 384Z" fill="var(--ink)" />

            <!-- group head -->
            <path d="M150 200H250V212C250 216 247 218 243 218H157C153 218 150 216 150 212Z" fill="var(--page)" />
            <path d="M160 218H240L234 234H166Z" fill="var(--page)" />

            <!-- portafilter: chrome basket and neck, black handle out to the front-left -->
            <path d="M158 234H242L236 256C234 262 166 262 164 256Z" fill="var(--page)" />
            <path d="M166 242 140 247 142 258 168 254Z" fill="var(--page)" />
            <path d="M141 247 86 258C70 262 72 281 88 277L143 258Z" fill="var(--ink)" />
            <path d="M184 260H216L212 270H188Z" fill="var(--ink)" />
            <path d="M190 270 189 278M210 270 211 278" stroke-width="5" />

            <!-- removable drip tray with its grille -->
            <path d="M100 420H300L312 432H88Z" fill="var(--page)" />
            <path d="M106 426H294" stroke-width="2.5" stroke-dasharray="8 5" />
            <path d="M88 432H312V446C312 450 309 452 305 452H95C91 452 88 450 88 446Z" fill="var(--page)" />
            <path d="M184 443H216" />
          </g>

          <!-- lights above the rockers: power always on, brew lights while pulling -->
          <circle cx="150" cy="151" r="4.5" fill="var(--accent)" stroke-width="2" />
          <circle class="pas-light" cx="200" cy="151" r="4.5" stroke-width="2" data-pas-brew-light data-on />
          <circle cx="250" cy="151" r="4.5" fill="var(--page)" stroke-width="2" />
          <!-- rocker faces: the ink half is the side pushed in -->
          <rect class="pas-rocker" x="138" y="163" width="24" height="9" fill="var(--ink)" stroke="none" data-on />
          <rect class="pas-rocker" x="188" y="163" width="24" height="9" fill="var(--ink)" stroke="none" data-pas-brew-switch data-on />
          <rect class="pas-rocker" x="238" y="163" width="24" height="9" fill="var(--ink)" stroke="none" />
          <text class="pas-plate" x="200" y="196" text-anchor="middle" fill="var(--ink)" stroke="none">GAGGIA</text>

          <!-- the Gaggiuino screen's live readout -->
          <g class="pas-screen" fill="var(--ink)" stroke="none">
            <text class="pas-scr-big" x="137" y="98" data-pas-scr-bar>{frozenBar.toFixed(1)}</text>
            <text class="pas-scr-small" x="186" y="98">bar</text>
            <text class="pas-scr-sec" x="263" y="96" text-anchor="end" data-pas-scr-sec>{Math.round(tip[0])}s</text>
          </g>
          <path d={`M${MINI.x0} ${my(9).toFixed(1)}H${MINI.x1}`} stroke="var(--ink-soft)" stroke-width="1.2" stroke-dasharray="2 4" />
          <path d={`M${MINI.x0} ${MINI.y1}H${MINI.x1}`} stroke-width="1.6" stroke-dasharray="none" />
          <path d={idealMini} stroke="var(--ink)" stroke-width="4.5" stroke-dasharray="none" data-pas-scr-ink />
          <path d={idealMini} stroke="var(--accent)" stroke-width="2.2" stroke-dasharray="none" data-pas-scr-line />
          <circle cx={mx(tip[0]).toFixed(1)} cy={my(tip[1]).toFixed(1)} r="2.6" fill="var(--accent)" stroke-width="1.5" data-pas-scr-head />

          <!-- cup, coffee, streams -->
          <path d={cup} fill="var(--page)" stroke="none" />
          <g clip-path="url(#pas-cup-clip)">
            <rect data-pas-coffee x="150" y={frozenTop} width="100" height={frozenFill + 4} fill="var(--ink)" stroke="none" />
            <rect data-pas-crema x="150" y={frozenTop} width="100" height="6" fill="var(--accent)" stroke="none" />
          </g>
          <path data-pas-stream d={streamPath(0, frozenTop)} stroke-width="3.5" stroke-dasharray="400 0" />
          <path data-pas-stream d={streamPath(1, frozenTop)} stroke-width="3.5" stroke-dasharray="400 0" />
          <path d={cup} />
          <path d="M237 362C262 360 262 394 233 392" />
          <g data-pas-steam class="pas-steam" stroke-width="2.5">
            <path d="M188 346C180 336 196 330 188 318" stroke-dasharray="5 6" />
            <path d="M212 348C204 336 220 330 212 316" stroke-dasharray="5 6" />
          </g>

          <!-- pump buzz marks, only while the pump runs -->
          <g class="pas-buzz" stroke-width="2.5">
            <path d="M52 380 44 385 52 390 44 395" stroke-dasharray="none" />
            <path d="M348 410 356 415 348 420 356 425" stroke-dasharray="none" />
          </g>
        </svg>
        <div class="pas-sfx-layer" data-pas-sfx aria-hidden="true"></div>
      </div>

      <div class="pas-controls">
        <button class="pas-pull" type="button" data-pas-pull aria-describedby="pas-help">Hold to pull</button>
        <button class="pas-sound" type="button" data-pas-sound aria-pressed="true">Sound on</button>
      </div>
      <p class="sr-only" id="pas-help">Press and hold. Space or Enter works too. Let go when the curve reaches the yellow band.</p>
    </div>

    <div class="pas-chart-col">
      <div class="pas-head">
        <h2 class="lettering">{heading}</h2>
        <p>{line}</p>
      </div>

      <div class="pas-meta">
        <span class="pas-profile">Gaggiuino-style profile</span>
        <span class="pas-phase" data-pas-phase aria-hidden="true">Mid-shot</span>
      </div>

      <div class="pas-chart-wrap">
        <svg class="pas-chart" viewBox={`0 0 ${CHART.w} ${CHART.h}`} fill="none" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="pas-chart-title">
          <title id="pas-chart-title">Pressure over one shot: pre-infusion at about 3 bar, a climb to a 9 bar plateau, then a slow decline.</title>
          <defs>
            <pattern id="pas-grid" x={CHART.x0} y={CHART.y0} width={gx} height={gy} patternUnits="userSpaceOnUse">
              <circle cx="0" cy="0" r="1.6" fill="var(--ink-soft)" />
              <circle cx={gx} cy="0" r="1.6" fill="var(--ink-soft)" />
              <circle cx="0" cy={gy} r="1.6" fill="var(--ink-soft)" />
              <circle cx={gx} cy={gy} r="1.6" fill="var(--ink-soft)" />
            </pattern>
            <pattern id="pas-dots" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <circle cx="4" cy="4" r="2.3" fill="var(--accent)" />
            </pattern>
          </defs>
          <rect x={CHART.x0} y={CHART.y0} width={CHART.x1 - CHART.x0} height={CHART.y1 - CHART.y0} fill="url(#pas-grid)" />
          <rect x={band.x} y={CHART.y0} width={band.w} height={CHART.y1 - CHART.y0} fill="var(--accent-tint)" />
          <path d={`M${band.x} ${CHART.y0}V${CHART.y1}M${band.x + band.w} ${CHART.y0}V${CHART.y1}`} stroke="var(--ink)" stroke-width="2" stroke-dasharray="6 6" />
          <text class="pas-band-label" x={band.x + band.w / 2} y={CHART.y0 + 22} text-anchor="middle">let go in here</text>

          <g class="pas-phases" stroke="var(--ink)" stroke-width="2">
            {phases.map((p) => (
              <>
                <path d={`M${p.x0.toFixed(1)} 72V64H${p.x1.toFixed(1)}V72`} />
                <text x={(p.from === 0 ? p.x0 : p.mid).toFixed(1)} y="56" text-anchor={p.from === 0 ? 'start' : 'middle'} stroke="none">{p.label}</text>
              </>
            ))}
          </g>

          <path data-pas-ghost d="" stroke="var(--ink-soft)" stroke-width="3" stroke-dasharray="2 9" />
          <path data-pas-area d={idealArea} fill="url(#pas-dots)" />
          <path data-pas-line-ink d={idealLine} stroke="var(--ink)" stroke-width="11" />
          <path data-pas-line d={idealLine} stroke="var(--accent)" stroke-width="5" />
          <circle data-pas-head cx={cx(tip[0])} cy={cy(tip[1])} r="8" fill="var(--accent)" stroke="var(--ink)" stroke-width="3.5" />

          <path class="boil" d={`M${CHART.x0} ${CHART.y0 - 6}V${CHART.y1}H${CHART.x1 + 6}`} stroke="var(--ink)" stroke-width="4" />
          <g class="pas-ticks" fill="var(--ink)">
            {yTicks.map((p) => <text x={CHART.x0 - 12} y={cy(p) + 6} text-anchor="end">{p}</text>)}
            {xTicks.map((s) => <text x={cx(s)} y={CHART.y1 + 26} text-anchor="middle">{s}</text>)}
            <text x={CHART.x0 + 10} y={CHART.y0 + 8}>bar</text>
            <text x={CHART.x1} y={CHART.y1 - 10} text-anchor="end">seconds</text>
          </g>
        </svg>
        <p class="pas-stamp" data-pas-stamp aria-hidden="true"></p>
      </div>

      <div class="pas-result" data-pas-result-row>
        <Image src={avatar} alt="" width={84} height={84} class="pas-face" />
        <p class="balloon" data-tail="left" data-pas-result aria-live="polite"></p>
      </div>

      <div class="pas-foot">
        <p class="pas-note">{note}</p>
        <a class="pas-more" href={href}>{linkText}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountRig } from './rig';

  let unmounts: Array<() => void> = [];
  const teardown = () => {
    unmounts.forEach((u) => u());
    unmounts = [];
  };
  document.addEventListener('astro:page-load', () => {
    teardown();
    unmounts = [...document.querySelectorAll<HTMLElement>('[data-pas-root]')].map(mountRig);
  });
  document.addEventListener('astro:before-swap', teardown);
</script>

<style>
  .pas-rig {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(20px, 3.5vw, 48px);
    align-items: start;
    padding-top: 58px;
  }

  /* ---------- the machine ---------- */
  .pas-machine-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .pas-machine-wrap {
    position: relative;
    width: min(100%, 400px);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  :global(.js) .pas-machine-wrap {
    cursor: pointer;
  }
  .pas-machine {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* The vibratory pump shakes the whole machine while it runs. */
  .pas-machine-wrap[data-running] .pas-machine {
    animation: pas-buzz 0.1s steps(2) infinite;
  }
  @keyframes pas-buzz {
    50% {
      transform: translate(0.8px, -0.6px);
    }
  }
  .pas-buzz {
    opacity: 0;
  }
  .pas-machine-wrap[data-running] .pas-buzz {
    opacity: 1;
    animation: pas-buzz-marks 0.16s steps(2) infinite;
  }
  @keyframes pas-buzz-marks {
    50% {
      transform: translateY(-3px);
    }
  }

  /* Rocker switches: the ink face sits on the bottom half (off) and
     flips to the top half (on) with a little overshoot. */
  .pas-rocker {
    transform: translateY(9px);
    transition: transform 0.16s var(--pop);
  }
  .pas-rocker[data-on] {
    transform: none;
  }
  .pas-light {
    fill: var(--page);
    transition: fill 0.1s;
  }
  .pas-light[data-on] {
    fill: var(--accent);
  }
  .pas-plate {
    font-family: var(--f-letter);
    font-size: 10px;
  }

  .pas-screen {
    font-family: var(--f-hand);
  }
  .pas-scr-big {
    font-size: 32px;
  }
  .pas-scr-small {
    font-size: 14px;
  }
  .pas-scr-sec {
    font-size: 22px;
  }

  .pas-steam {
    opacity: 0;
    transition: opacity 0.6s;
  }
  .pas-steam[data-on] {
    opacity: 1;
    animation: pas-steam 1.6s steps(4) infinite;
  }
  @keyframes pas-steam {
    50% {
      transform: translateY(-5px);
    }
  }

  .pas-controls {
    display: none;
    width: min(100%, 400px);
    gap: 10px;
    align-items: center;
  }
  :global(.js) .pas-controls {
    display: flex;
  }
  .pas-pull {
    flex: 1;
    font-family: var(--f-letter);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1;
    color: var(--ink);
    background: var(--accent);
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    padding: 18px 16px 16px;
    white-space: nowrap;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition:
      transform 0.18s var(--pop),
      background-color 0.1s,
      color 0.1s;
  }
  .pas-pull:hover {
    transform: rotate(-1.5deg);
  }
  .pas-pull[data-held] {
    background: var(--ink);
    color: var(--accent);
    transform: translateY(3px) scale(0.97);
  }
  .pas-pull:focus-visible,
  .pas-sound:focus-visible,
  .pas-more:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  .pas-sound {
    font-family: var(--f-hand);
    font-size: 1.05rem;
    line-height: 1.1;
    color: var(--ink);
    background: var(--page);
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
    width: 6.6em;
  }
  .pas-sound[aria-pressed='false'] {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }

  /* ---------- sound effects ---------- */
  .pas-sfx-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .pas-sfx-layer :global(.pas-sfx) {
    position: absolute;
    font-family: var(--f-letter);
    font-size: clamp(1.5rem, 3.6vw, 2.5rem);
    line-height: 1;
    color: var(--accent);
    -webkit-text-stroke: 0.1em var(--ink);
    paint-order: stroke fill;
    white-space: nowrap;
    rotate: var(--pas-r, -8deg);
    animation: pas-sfx 1.25s var(--pop) both;
  }
  .pas-sfx-layer :global(.pas-sfx.pas-small) {
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
  }
  @keyframes pas-sfx {
    0% {
      transform: scale(0.2);
      opacity: 0;
    }
    18% {
      transform: scale(1.12);
      opacity: 1;
    }
    30% {
      transform: scale(1);
    }
    80% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    100% {
      opacity: 0;
      transform: scale(0.96) translateY(-10px);
    }
  }

  /* ---------- chart side ---------- */
  .pas-chart-col {
    min-width: 0;
  }
  .pas-head h2 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    margin-bottom: 12px;
  }
  .pas-head p {
    max-width: 50ch;
  }
  .pas-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-family: var(--f-hand);
    font-size: 1.2rem;
    margin: 6px 0 8px;
  }
  .pas-phase {
    margin-left: auto;
    background: var(--accent);
    border: var(--line) solid var(--ink);
    padding: 2px 10px 1px;
    font-size: 1.15rem;
  }
  .pas-phase:global(.pas-flash) {
    animation: pas-phase-pop 0.35s var(--pop);
  }
  @keyframes pas-phase-pop {
    from {
      transform: scale(0.7) rotate(-4deg);
    }
  }
  .pas-chart-wrap {
    position: relative;
  }
  .pas-chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pas-band-label,
  .pas-ticks,
  .pas-phases {
    font-family: var(--f-hand);
    font-size: 19px;
  }
  .pas-band-label,
  .pas-phases text {
    fill: var(--ink);
  }
  .pas-stamp {
    position: absolute;
    left: 50%;
    top: 46%;
    margin: 0;
    font-family: var(--f-letter);
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 1;
    color: var(--accent);
    -webkit-text-stroke: 0.09em var(--ink);
    paint-order: stroke fill;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(-7deg);
  }
  .pas-stamp:empty {
    display: none;
  }
  .pas-stamp:global(.pas-hit) {
    animation: pas-stamp-in 0.45s var(--pop) both;
  }
  .pas-stamp[data-tone='bad'] {
    color: var(--page);
  }
  @keyframes pas-stamp-in {
    from {
      transform: translate(-50%, -50%) scale(1.8) rotate(-14deg);
      opacity: 0;
    }
  }

  .pas-result {
    display: none;
    align-items: flex-end;
    gap: 6px;
    margin-top: 8px;
  }
  .pas-result[data-show] {
    display: flex;
  }
  .pas-face {
    width: 72px;
    height: auto;
    flex: none;
  }
  .pas-result .balloon {
    font-size: 1.15rem;
    padding: 12px 22px;
    margin-bottom: 34px;
  }
